---
import Layout from "../layouts/Layout.astro";
import OffersStats from "../components/OffersStats.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import Stages from "../components/Stages.astro";
import Gallery from "../components/Gallery.astro";
import Reviews from "../components/Reviews.astro";
import FAQ from "../components/FAQ.astro";
import CallBanner from "../components/CallBanner.astro";
import { site } from "../data/site";
import { primaryServices } from "../data/services";
import { locations } from "../data/locations";

---
<Layout>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__overlay"></div>
    <div class="container hero__inner">
      <div class="hero__text">
        <span class="eyebrow eyebrow--ondark">San Jose &amp; the Bay Area · Open 7 Days</span>
        <h1>Keeping your home <em>comfortable</em>, all year round.</h1>
        <p>Friendly, licensed HVAC pros for repairs, installations &amp; maintenance across San Jose — same-day service and honest, upfront pricing you can trust.</p>

        <div class="hero__btns">
          <a href={site.phoneHref} class="callbtn" aria-label={`Call ${site.name} now at ${site.phone}. Open now, 7 days a week.`}>
            <span class="callbtn__inner">
              <span class="callbtn__media" aria-hidden="true">
                <svg class="callbtn__phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.3 11.3 0 0 0 3.55.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.3a1 1 0 0 1 1 1 11.3 11.3 0 0 0 .57 3.55 1 1 0 0 1-.24 1Z"/>
                </svg>
                <span class="callbtn__live">
                  <span class="callbtn__ring"></span>
                  <span class="callbtn__dot"></span>
                </span>
              </span>
              <span class="callbtn__body">
                <span class="callbtn__status">
                  <span class="callbtn__statusdot" aria-hidden="true"></span>
                  Open now · 7 days
                </span>
                <span class="callbtn__num">{site.phone}</span>
              </span>
              <svg class="callbtn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 6l6 6-6 6"/>
              </svg>
              <span class="callbtn__sheen" aria-hidden="true"></span>
            </span>
          </a>
          <a href="/contact" class="btn btn--soft btn--lg">Get a Free Estimate</a>
        </div>

        <div class="hero__proof">
          <div class="hero__stars"><span>★★★★★</span> Rated 5 stars by local homeowners</div>
          <div class="hero__facts">
            <span>Licensed &amp; Insured</span>
            <span>EPA Certified</span>
            <span>Free Estimates</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <OffersStats />

  <!-- Services -->
  <section class="section section--alt" id="services">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">HVAC in San Jose, CA</span>
        <h2>Our Services</h2>
        <p>Repair, installation, maintenance &amp; replacement for every part of your home comfort system.</p>
      </div>
      <div class="grid cols-4 svc-grid">
        {primaryServices.map((s) => (
          <a href={`/services/${s.slug}`} class="svc reveal">
            <div class="svc__img"><img src={s.image} alt={s.name} loading="lazy" /></div>
            <div class="svc__body">
              <h3>{s.name}</h3>
              <span class="svc__link">Request Service →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CallBanner heading="Repair, installation & maintenance — every day of the week." />

  <WhyChooseUs />
  <Gallery />

  <!-- About (slim credibility band) -->
  <section class="section section--alt" id="about">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">About Promax</span>
        <h2>A Licensed Local Team You Can Trust</h2>
        <p>Promax Service Group is a licensed, EPA-certified HVAC contractor serving San Jose and the greater Bay Area. As a <strong>Mitsubishi Diamond Contractor</strong> and <strong>Bryant Premier Dealer</strong>, we install and service top-tier equipment to the highest standards — and as a TECH Clean California certified contractor, we help you unlock HEEHRA rebates on qualifying high-efficiency systems.</p>
      </div>
      <div class="about__creds reveal">
        <div class="cred"><strong>Mitsubishi</strong><span>Diamond Contractor</span></div>
        <div class="cred"><strong>Bryant</strong><span>Premier Dealer</span></div>
        <div class="cred"><strong>EPA</strong><span>Certified</span></div>
        <div class="cred"><strong>Licensed</strong><span>{site.license}</span></div>
      </div>
      <div class="about__badges reveal">
        {site.certBadges.map((b) => <img src={b.src} alt={b.alt} loading="lazy" />)}
      </div>
    </div>
  </section>

  <Stages />

  <!-- Testimonials (cards built from src/data/reviews.ts) -->
  <Reviews />

  <!-- Locations -->
  <section class="section" id="locations">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Service Area</span>
        <h2>San Jose &amp; Neighboring Areas</h2>
        <p>Proudly serving homeowners and businesses across Silicon Valley and the Peninsula.</p>
      </div>
      <div class="area reveal">
        <img class="area__map" src="/images/map.jpg" alt="Promax service area map — San Jose and the Bay Area" loading="lazy" />
        <div class="loc-grid">
          {locations.map((l) => (
            <a href={`/locations/${l.slug}`} class="loc">📍 {l.city}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <FAQ />

  <CallBanner heading="Ready to get comfortable? Contact Promax today." />
</Layout>

<style>
  /* ===== Hero (full-bleed image) ===== */
  .hero { position: relative; isolation: isolate; background: #1a1410; }
  .hero::before {
    content: ""; position: absolute; inset: 0; z-index: 0;
    background: url("/images/photo_hvac-min.jpg") center 35% / cover no-repeat;
    filter: brightness(1.16) saturate(1.05);
  }
  .hero__overlay {
    position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(90deg, rgba(22,17,13,.80) 0%, rgba(22,17,13,.50) 46%, rgba(22,17,13,.14) 100%),
      linear-gradient(180deg, rgba(22,17,13,.06), rgba(22,17,13,.30));
  }
  .hero__inner {
    position: relative; z-index: 2;
    display: flex; align-items: center;
    min-height: clamp(560px, 84vh, 800px);
    padding: 96px 22px;
  }
  .hero__text { max-width: 620px; }
  .eyebrow--ondark { background: rgba(255,255,255,.14); color: #ffd9a8; -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); }
  .hero h1 { font-size: clamp(2.7rem, 5.2vw, 4.3rem); color: #fff; }
  .hero h1 em { font-style: italic; color: var(--amber); }
  .hero p { font-size: 1.18rem; color: #eae1d6; max-width: 540px; margin-top: 16px; }

  .hero__btns { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin: 32px 0 28px; }
  /* pair the secondary button with the call card's corner family */
  .hero__btns .btn--soft.btn--lg { border-radius: var(--radius); }

  /* ===== Live Line — availability status-card call button ===== */
  .callbtn {
    --cb-green: #178045;
    --cb-green-bright: #29b765;
    position: relative; display: inline-flex; text-decoration: none;
    border-radius: var(--radius);
    background: radial-gradient(120% 140% at 0% 0%, var(--orange-soft) 0%, rgba(251,238,222,0) 55%), var(--white);
    border: 1px solid var(--line); box-shadow: var(--shadow);
    cursor: pointer; -webkit-tap-highlight-color: transparent;
    transition: transform .25s cubic-bezier(.2,.7,.3,1), box-shadow .25s ease, border-color .25s ease;
  }
  .callbtn__inner {
    position: relative; display: inline-flex; align-items: center; gap: 14px;
    min-height: 64px; width: 100%; padding: 10px 18px 10px 12px; box-sizing: border-box;
    border-radius: inherit; overflow: hidden; isolation: isolate;
  }
  .callbtn__media {
    position: relative; flex: none; display: grid; place-items: center;
    width: 44px; height: 44px; border-radius: 13px; color: var(--white);
    background: linear-gradient(150deg, var(--orange-bright) 0%, var(--orange) 52%, var(--orange-deep) 100%);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.35), 0 6px 14px -6px rgba(184,86,0,.55);
    transition: background .25s ease, box-shadow .25s ease, transform .25s ease;
  }
  .callbtn__phone { width: 21px; height: 21px; }
  .callbtn__live {
    position: absolute; top: -4px; right: -4px; width: 16px; height: 16px;
    border-radius: var(--pill); background: var(--white); display: grid; place-items: center;
    box-shadow: 0 1px 3px rgba(44,39,34,.25);
  }
  .callbtn__dot {
    position: relative; z-index: 1; width: 9px; height: 9px; border-radius: var(--pill);
    background: radial-gradient(circle at 35% 30%, var(--cb-green-bright), var(--cb-green));
  }
  .callbtn__ring {
    position: absolute; inset: 0; margin: auto; width: 9px; height: 9px; border-radius: var(--pill);
    background: var(--cb-green-bright); opacity: 0;
  }
  .callbtn__body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .callbtn__status {
    display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-head);
    font-size: 12px; font-weight: 700; letter-spacing: .055em; text-transform: uppercase;
    color: var(--cb-green); line-height: 1;
  }
  .callbtn__statusdot {
    flex: none; width: 7px; height: 7px; border-radius: var(--pill);
    background: var(--cb-green-bright); box-shadow: 0 0 0 3px rgba(41,183,101,.18);
  }
  .callbtn__num {
    font-family: var(--font-display); font-size: 22px; font-weight: 600; letter-spacing: -.005em;
    line-height: 1.08; color: var(--slate); white-space: nowrap; font-variant-numeric: tabular-nums;
  }
  .callbtn__arrow {
    flex: none; width: 20px; height: 20px; margin-left: 4px; color: var(--muted);
    transition: transform .25s cubic-bezier(.2,.7,.3,1), color .25s ease;
  }
  .callbtn__sheen {
    position: absolute; top: 0; left: 0; width: 55%; height: 100%; pointer-events: none;
    background: linear-gradient(100deg, transparent 0%, rgba(255,255,255,.55) 50%, transparent 100%);
    transform: translateX(-160%) skewX(-16deg); opacity: 0; z-index: 2;
  }
  .callbtn:hover { transform: translateY(-2px); border-color: var(--orange-soft); box-shadow: var(--shadow-lg); }
  .callbtn:hover .callbtn__media {
    background: linear-gradient(150deg, var(--amber) 0%, var(--orange-bright) 45%, var(--orange) 100%);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.45), 0 9px 20px -7px rgba(184,86,0,.65); transform: scale(1.03);
  }
  .callbtn:hover .callbtn__arrow { transform: translateX(3px); color: var(--orange); }
  .callbtn:active { transform: translateY(0); box-shadow: var(--shadow); }
  .callbtn:focus-visible {
    outline: none; border-color: var(--orange);
    box-shadow: 0 0 0 3px var(--white), 0 0 0 5px var(--orange), var(--shadow);
  }
  @media (prefers-reduced-motion: no-preference) {
    .callbtn__ring { animation: callbtn-pulse 2.4s ease-out infinite; }
    .callbtn__statusdot { animation: callbtn-breathe 2.4s ease-in-out infinite; }
    .callbtn:hover .callbtn__sheen { animation: callbtn-sheen .9s ease forwards; }
    @keyframes callbtn-pulse { 0% { opacity: .5; transform: scale(1);} 70% { opacity: 0; transform: scale(2.6);} 100% { opacity: 0; transform: scale(2.6);} }
    @keyframes callbtn-breathe { 0%,100% { box-shadow: 0 0 0 3px rgba(41,183,101,.18);} 50% { box-shadow: 0 0 0 4px rgba(41,183,101,.07);} }
    @keyframes callbtn-sheen { 0% { opacity: 0; transform: translateX(-160%) skewX(-16deg);} 12% { opacity: 1;} 100% { opacity: 0; transform: translateX(320%) skewX(-16deg);} }
  }
  @media (max-width: 480px) {
    .callbtn { width: 100%; }
    .callbtn__inner { justify-content: flex-start; }
    .callbtn__arrow { margin-left: auto; }
  }

  .hero__proof { display: flex; flex-direction: column; gap: 16px; }
  .hero__stars { display: flex; align-items: center; gap: 9px; color: #eae1d6; font-weight: 600; font-size: .94rem; }
  .hero__stars span { color: var(--amber); letter-spacing: 2px; font-size: 1.08rem; }
  .hero__facts { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .hero__facts span {
    background: rgba(255,255,255,.10); border: 1px solid rgba(255,255,255,.18);
    color: #f2e9de; border-radius: var(--pill); padding: 6px 14px; font-size: .82rem;
    -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
  }
  .hero__facts span::before { content: "✓ "; color: var(--amber); }

  @media (prefers-reduced-motion: no-preference) {
    .hero__text > * { opacity: 0; transform: translateY(20px); animation: heroIn .7s cubic-bezier(.2,.7,.3,1) forwards; }
    .hero__text > *:nth-child(1) { animation-delay: .05s; }
    .hero__text > *:nth-child(2) { animation-delay: .14s; }
    .hero__text > *:nth-child(3) { animation-delay: .23s; }
    .hero__text > *:nth-child(4) { animation-delay: .32s; }
    .hero__text > *:nth-child(5) { animation-delay: .41s; }
    .hero__media { opacity: 0; transform: translateY(20px) scale(.98); animation: heroIn .85s cubic-bezier(.2,.7,.3,1) .3s forwards; }
    @keyframes heroIn { to { opacity: 1; transform: none; } }
  }

  /* About (slim credibility band) */
  .about__creds { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin-bottom: 30px; }
  .cred { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 26px; text-align: center; min-width: 150px; }
  .cred strong { display: block; font-family: var(--font-head); color: var(--orange); font-size: 1.1rem; line-height: 1.1; }
  .cred span { color: var(--muted); font-size: .85rem; }
  .about__badges { display: flex; justify-content: center; align-items: center; gap: 24px; flex-wrap: wrap; }
  .about__badges img { height: 66px; width: auto; }

  /* Services */
  .svc { display: block; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; transition: .25s ease; }
  .svc:hover { box-shadow: var(--shadow-lg); transform: translateY(-6px); border-color: transparent; }
  .svc__img { aspect-ratio: 4/3; overflow: hidden; background: #eef1f4; }
  .svc__img img { width: 100%; height: 100%; object-fit: cover; transition: .35s ease; }
  .svc:hover .svc__img img { transform: scale(1.07); }
  .svc__body { padding: 20px 22px; }
  .svc__body h3 { font-size: 1.08rem; margin-bottom: 4px; color: var(--slate); }
  .svc__link { color: var(--orange); font-weight: 600; font-size: .9rem; }

  /* Service area */
  .area { display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: center; }
  .area__map { width: 100%; border-radius: var(--radius); box-shadow: var(--shadow); }
  .loc-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .loc { background: var(--bg-alt); border: 1px solid var(--line); border-radius: 10px; padding: 13px 16px; color: var(--slate); font-weight: 500; font-size: .95rem; transition: .18s ease; }
  .loc:hover { background: var(--orange); color: #fff; border-color: var(--orange); transform: translateY(-2px); }

  @media (max-width: 900px) {
    .area { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .hero__inner { min-height: 70vh; padding: 80px 22px; }
    .hero__overlay { background: linear-gradient(180deg, rgba(22,17,13,.62), rgba(22,17,13,.74)); }
    .promo-strip { margin-top: 44px; }
    .loc-grid { grid-template-columns: 1fr; }
  }
</style>
