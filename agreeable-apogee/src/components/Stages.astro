---
const steps = [
  { n: "01", title: "Request", text: "Contact us with your HVAC concerns. We'll listen carefully and arrange a convenient appointment for a diagnostic visit." },
  { n: "02", title: "Technician Visit & Diagnosis", text: "Our certified technician examines your system on-site to identify the root cause of the problem." },
  { n: "03", title: "Estimate Provided", text: "You receive a detailed, no-obligation estimate outlining the issue, proposed solution, and associated costs." },
  { n: "04", title: "Your Decision", text: "Take your time to review the estimate. If you're happy with it, we move forward — questions welcome anytime." },
  { n: "05", title: "Parts & Scheduling", text: "Once approved, we order any necessary parts and schedule the repair at a time that's convenient for you." },
];
---
<section class="section" id="process">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">How We Work</span>
      <h2>Our Stages of Work</h2>
      <p>We keep our service process simple and transparent. Here's how we work with you.</p>
    </div>
    <div class="steps">
      {steps.map((s) => (
        <div class="step">
          <span class="step__n">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .steps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; }
  .step { position: relative; padding: 28px 20px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); }
  .step__n { font-family: var(--font-head); font-weight: 800; font-size: 2rem; color: var(--amber); display: block; margin-bottom: 6px; }
  .step h3 { font-size: 1.05rem; }
  .step p { font-size: .9rem; color: var(--muted); margin: 0; }
  @media (max-width: 980px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }
</style>
