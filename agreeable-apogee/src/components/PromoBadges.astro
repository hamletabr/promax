---
import { site } from "../data/site";
---
<div class="promos">
  {site.promos.map((p) => (
    <div class="promo">
      <img class="promo__icon" src={p.icon} alt="" width="48" height="48" />
      <div>
        <span class="promo__big">{p.big}</span>
        <span class="promo__small">{p.small}</span>
      </div>
    </div>
  ))}
</div>

<style>
  .promos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .promo {
    display: flex; align-items: center; gap: 14px;
    background: #fff; border: 1px solid var(--line); border-left: 5px solid var(--orange);
    border-radius: var(--radius); padding: 18px 22px; box-shadow: var(--shadow);
  }
  .promo__icon { width: 48px; height: 48px; object-fit: contain; flex-shrink: 0; }
  .promo__big { display: block; font-family: var(--font-head); font-weight: 800; font-size: 1.9rem; color: var(--orange); line-height: 1; }
  .promo__small { font-size: .95rem; color: var(--muted); }
  @media (max-width: 720px) { .promos { grid-template-columns: 1fr; } }
</style>
