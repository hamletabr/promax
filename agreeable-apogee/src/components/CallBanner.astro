---
import { site } from "../data/site";
const { heading } = Astro.props;
---
<section class="callban">
  <div class="container callban__inner">
    <div>
      <span class="callban__eyebrow">We Work Every Day · 7:00 AM – 10:00 PM</span>
      <h2>{heading ?? "Need HVAC help today? We're ready."}</h2>
    </div>
    <div class="callban__cta">
      <span>Call Us Today!</span>
      <a href={site.phoneHref}>{site.phone}</a>
    </div>
  </div>
</section>

<style>
  .callban { background: linear-gradient(100deg, var(--orange), var(--orange-bright)); color: #fff; }
  .callban__inner { display: flex; align-items: center; justify-content: space-between; gap: 28px; padding: 40px 20px; flex-wrap: wrap; }
  .callban__eyebrow { text-transform: uppercase; letter-spacing: .1em; font-size: .8rem; opacity: .9; }
  .callban h2 { color: #fff; margin: 6px 0 0; }
  .callban__cta { text-align: right; }
  .callban__cta span { display: block; font-size: .85rem; opacity: .9; }
  .callban__cta a { font-family: var(--font-head); font-weight: 800; font-size: 2rem; color: #fff; }
  @media (max-width: 640px) { .callban__cta { text-align: left; } }
</style>
