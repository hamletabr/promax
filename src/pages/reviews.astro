---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CallBanner from "../components/CallBanner.astro";
import { site } from "../data/site";
import { reviews } from "../data/reviews";

const title = "Reviews — Promax Service Group | 5-Star HVAC in San Jose, CA";
// Only reviews that actually came from Google back the "Google reviews" claims.
const google = reviews.filter((r) => !r.source || r.source === "Google");
const metaDesc = `Read ${google.length}+ verified 5-star Google reviews of Promax Service Group — HVAC repair, heat pumps, mini splits and water heaters in San Jose.`;

const avg = (google.reduce((s, r) => s + r.rating, 0) / google.length).toFixed(1);

// HVAC reviews lead the page (this is an HVAC site); electrical/handyman jobs
// for the same customers are real work too, so they stay — just grouped below.
const hvacReviews = reviews.filter((r) => r.category === "hvac");
const otherReviews = reviews.filter((r) => r.category !== "hvac");

const reviewsSchema = {
  "@context": "https://schema.org",
  "@type": "HVACBusiness",
  "@id": `${site.url}/#business`,
  name: site.name,
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: avg,
    reviewCount: google.length,
    bestRating: 5,
  },
  review: reviews.slice(0, 10).map((r) => ({
    "@type": "Review",
    author: { "@type": "Person", name: r.name },
    reviewRating: { "@type": "Rating", ratingValue: r.rating, bestRating: 5 },
    reviewBody: r.text,
  })),
};

function initials(name: string) {
  const parts = name.replace(/,.*$/, "").trim().split(/\s+/);
  return ((parts[0]?.[0] ?? "") + (parts[1]?.[0] ?? "")).toUpperCase();
}
const colors = ["#ea580c", "#13273f", "#0a9d6e", "#3b6fd4", "#b4476f", "#7a55c9"];
---
<Layout title={title} description={metaDesc} preloadImage="/images/photo_hvac-min.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(reviewsSchema)} is:inline />

  <PageHero
    eyebrow="Customer Reviews"
    title="What San Jose Homeowners Say About Us"
    sub={`Rated ${avg} out of 5 from verified Google reviews. Every review below is from a real customer — heating rescues, mini split installs, water heaters, and more.`}
    image="/images/photo_hvac-min.jpg"
    parentLabel="Reviews"
    parentHref="/reviews"
  />

  <section class="section">
    <div class="container">
      <div class="rv-summary reveal">
        <div class="rv-score">
          <strong>{avg}</strong>
          <span class="rv-stars" aria-label={`${avg} out of 5 stars`}>★★★★★</span>
          <span class="rv-count">{google.length}+ verified Google reviews</span>
        </div>
        <div class="rv-actions">
          <a href={site.googleReviewsUrl} target="_blank" rel="noopener" class="btn btn--outline">Read on Google</a>
          <a href={site.googleReviewsUrl} target="_blank" rel="noopener" class="btn btn--primary">Leave Us a Review</a>
        </div>
      </div>

      <div class="rv-grid">
        {hvacReviews.map((r, i) => (
          <article class="rv card reveal">
            <div class="rv__head">
              <span class="rv__avatar" style={`background:${colors[i % colors.length]}`}>{initials(r.name)}</span>
              <div>
                <strong>{r.name}</strong>
                <span class="rv__meta">{r.date}{r.source ? ` · ${r.source}` : ""}</span>
              </div>
              <span class="rv__stars" aria-label={`${r.rating} out of 5 stars`}>{"★".repeat(r.rating)}</span>
            </div>
            {r.service && <span class="rv__tag">{r.service}</span>}
            <p class="rv__text">{r.text}{r.truncated ? "…" : ""}</p>
            {r.ownerResponse && (
              <details class="rv__reply">
                <summary>Response from Promax</summary>
                <p>{r.ownerResponse}{r.ownerResponseTruncated ? "…" : ""}</p>
              </details>
            )}
          </article>
        ))}
      </div>

      {otherReviews.length > 0 && (
        <>
          <div class="section-head reveal rv-other-head">
            <h2>Other Work Our Customers Mention</h2>
            <p>Promax also handles electrical and handyman requests for the same San Jose homeowners who trust us with HVAC — these reviews are real, so we're not hiding them, just keeping them separate from the HVAC feedback above.</p>
          </div>
          <div class="rv-grid">
            {otherReviews.map((r, i) => (
              <article class="rv card reveal">
                <div class="rv__head">
                  <span class="rv__avatar" style={`background:${colors[i % colors.length]}`}>{initials(r.name)}</span>
                  <div>
                    <strong>{r.name}</strong>
                    <span class="rv__meta">{r.date}{r.source ? ` · ${r.source}` : ""}</span>
                  </div>
                  <span class="rv__stars" aria-label={`${r.rating} out of 5 stars`}>{"★".repeat(r.rating)}</span>
                </div>
                {r.service && <span class="rv__tag">{r.service}</span>}
                <p class="rv__text">{r.text}{r.truncated ? "…" : ""}</p>
                {r.ownerResponse && (
                  <details class="rv__reply">
                    <summary>Response from Promax</summary>
                    <p>{r.ownerResponse}{r.ownerResponseTruncated ? "…" : ""}</p>
                  </details>
                )}
              </article>
            ))}
          </div>
        </>
      )}

      <p class="rv-foot reveal">
        Had a great experience with our team? <a href={site.googleReviewsUrl} target="_blank" rel="noopener">Share it on Google</a> —
        it means the world to a local business. Something we should fix? Call {site.phone} and ask for a manager; we make it right.
      </p>
    </div>
  </section>

  <CallBanner heading="Join hundreds of happy Bay Area homeowners — book your service today." />
</Layout>

<style>
  .rv-summary {
    display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;
    background: var(--bg-alt); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: 26px 32px; margin-bottom: 36px;
  }
  .rv-score { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .rv-score strong { font-family: var(--font-head); font-weight: 800; font-size: 3rem; color: var(--slate); line-height: 1; }
  .rv-stars { color: var(--amber); font-size: 1.5rem; letter-spacing: 3px; }
  .rv-count { color: var(--muted); font-weight: 600; }
  .rv-actions { display: flex; gap: 12px; flex-wrap: wrap; }

  .rv-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .rv-other-head { margin-top: 48px; margin-bottom: 24px; }
  .rv { padding: 24px; }
  .rv__head { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .rv__avatar {
    flex: none; width: 44px; height: 44px; border-radius: 50%; color: #fff;
    display: grid; place-items: center; font-family: var(--font-head); font-weight: 700; font-size: .95rem;
  }
  .rv__head strong { display: block; font-family: var(--font-head); font-size: .95rem; color: var(--slate); }
  .rv__meta { font-size: .78rem; color: var(--muted); }
  .rv__stars { margin-left: auto; color: var(--amber); letter-spacing: 1px; }
  .rv__tag {
    display: inline-block; background: var(--orange-soft); color: var(--orange-deep);
    font-size: .72rem; font-weight: 700; border-radius: var(--pill); padding: 4px 12px; margin-bottom: 10px;
  }
  .rv__text { font-size: .92rem; color: var(--slate-2); margin: 0; }
  .rv__reply { margin-top: 12px; border-top: 1px solid var(--line); padding-top: 10px; }
  .rv__reply summary { cursor: pointer; font-size: .82rem; font-weight: 700; color: var(--orange-deep); }
  .rv__reply p { font-size: .86rem; color: var(--muted); margin: 8px 0 0; }

  .rv-foot { text-align: center; color: var(--muted); margin-top: 36px; }

  @media (max-width: 980px) { .rv-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .rv-grid { grid-template-columns: 1fr; } }
</style>
