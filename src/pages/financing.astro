---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CallBanner from "../components/CallBanner.astro";
import EstimateButton from "../components/EstimateButton.astro";
import CallButton from "../components/CallButton.astro";
import FAQ from "../components/FAQ.astro";
import { site } from "../data/site";

const title = "HVAC Financing & Rebates in San Jose | Promax";
const metaDesc =
  "Finance a new HVAC system in San Jose with monthly plans on approved credit. We check every rebate and utility incentive you qualify for at your estimate.";

const rebates = [
  {
    name: "Federal 25C Tax Credit",
    amount: "Expired",
    gone: true,
    text: "The federal 25C credit (30% of cost, up to $2,000/yr) expired for installations completed after December 31, 2025, and is no longer available for new projects. We check every rebate and incentive you qualify for at your free estimate.",
  },
  {
    name: "HEEHRA (income-qualified)",
    amount: "Waitlist only",
    gone: true,
    text: "HEEHRA single-family funding is fully reserved statewide. We can add income-qualified households to the waitlist and apply the rebate to your project automatically if funds return.",
  },
  {
    name: "Utility & local programs",
    amount: "Varies",
    text: "PG&E, SVCE, and San José Clean Energy periodically offer additional efficiency incentives — duct sealing, smart thermostats, and more. We track them so you don't have to.",
  },
  {
    name: "TECH Clean California",
    amount: "Funding exhausted",
    gone: true,
    text: "TECH's statewide heat pump rebate funding is currently used up, so this incentive is not available right now. We watch for new funding waves closely — if the program reopens, we apply it to eligible quotes automatically.",
  },
];

const steps = [
  ["Get your free estimate", "In-home visit with good/better/best options and real numbers — including every rebate you qualify for."],
  ["Pick payments that fit", "Apply for financing in minutes (approved credit). Many customers pay for a new system with the money it saves on utilities."],
  ["We install & you relax", "Permits, HERS testing, rebate paperwork, and cleanup handled — we confirm the exact timeline in your free estimate."],
];

const faqs = [
  {
    q: "What financing options do you offer?",
    a: "We offer plans on approved credit through our financing partner, with terms from 12 to 120 months. We show you the exact monthly payment for your project during your free estimate — approval usually takes just a few minutes.",
  },
  {
    q: "Can I combine financing with rebates?",
    a: "Yes. Any live utility incentive is applied at the point of sale, and financing spreads what's left into a comfortable monthly payment. Note: the federal 25C tax credit has expired for installs after 2025, and HEEHRA's income-qualified single-family funding is fully reserved statewide (we can add you to the waitlist). We check every rebate and incentive you currently qualify for at your free estimate.",
  },
  {
    q: "Are TECH Clean California, 25C, or HEEHRA rebates still available?",
    a: "TECH Clean California's funding is exhausted statewide, and the federal 25C tax credit expired for installations after December 31, 2025 — neither is available right now. HEEHRA's income-qualified single-family funding is fully reserved statewide; we can add you to the waitlist and apply it if funds return. Utility programs are still active, and we check every rebate and incentive you qualify for at your free estimate.",
  },
  {
    q: "Do rebates apply to repairs too?",
    a: "Rebates target high-efficiency equipment upgrades — heat pumps, heat pump water heaters, and sometimes duct sealing or smart thermostats. Repairs don't qualify, but the diagnostic fee is waived with any repair.",
  },
  {
    q: "How do I know what my new system will really cost?",
    a: "Use our online estimator for an instant ballpark range, then get exact numbers with a free on-site estimate. Your written quote itemizes equipment, labor, permits, every rebate you qualify for, and — if you finance — the exact monthly payment.",
  },
];
---
<Layout title={title} description={metaDesc} preloadImage="/images/heat-pump-photo-min.jpg">
  <PageHero
    eyebrow="Financing & Rebates"
    title="A New HVAC System, Without the Sticker Shock"
    sub="Split the cost into a comfortable monthly payment, and let every rebate and utility incentive you qualify for cover part of the rest. We handle all the paperwork."
    image="/images/heat-pump-photo-min.jpg"
    parentLabel="Financing"
    parentHref="/financing"
  />

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Stack Your Savings</span>
        <h2>Rebates & Incentives We Apply For You</h2>
        <p>California is paying homeowners to upgrade to efficient electric systems. We're enrolled, certified, and do the paperwork.</p>
      </div>
      <div class="grid cols-2">
        {rebates.map((r) => (
          <div class:list={["card", "rebate", "reveal", { "rebate--gone": r.gone }]}>
            <span class:list={["rebate__amount", { "rebate__amount--gone": r.gone }]}>{r.amount}</span>
            <h3>{r.name}</h3>
            <p>{r.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">How It Works</span>
        <h2>From Quote to Comfort in Three Steps</h2>
      </div>
      <div class="grid cols-3">
        {steps.map(([t, d], i) => (
          <div class="card fstep reveal">
            <span class="fstep__num">{i + 1}</span>
            <h3>{t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>
      <div class="fin-ctas reveal">
        <CallButton />
        <EstimateButton label="Get My Instant Estimate" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">The Real Question</span>
        <h2>How the Monthly Payment Works</h2>
        <p>
          We finance through our financing partner, on approved credit, with terms from 12 to 120 months.
          Rather than quote a generic rate online, we show you the exact monthly figure — and the price net of every rebate
          you qualify for — during your free in-home estimate.
        </p>
      </div>
      <!-- TODO(owner): lender name, representative APR/term, apply link -->
      <div class="fin-monthly reveal">
        <ul>
          <li><strong>Approved credit, flexible terms.</strong> 12 to 120 months through our financing partner — pick a term that fits your budget.</li>
          <li><strong>No guessing.</strong> Your free estimate shows the exact monthly payment and the price after every rebate and incentive you qualify for.</li>
          <li><strong>Apply when you're ready.</strong> Once you've picked your equipment, financing approval typically takes just a few minutes.</li>
        </ul>
        <div class="fin-ctas">
          <CallButton />
          <EstimateButton label="See My Monthly Payment" />
        </div>
        <p class="fin-ctas__or">Prefer to pick a time yourself? <a href={site.bookingUrl} target="_blank" rel="noopener">Book online →</a></p>
      </div>
    </div>
  </section>

  <CallBanner heading="Wondering what you qualify for? One call answers it." />
  <FAQ items={faqs} />
</Layout>

<style>
  .rebate { position: relative; }
  .rebate__amount {
    display: inline-block; background: var(--orange-soft); color: var(--orange-deep);
    font-family: var(--font-head); font-weight: 700; font-size: .95rem;
    border-radius: var(--pill); padding: 6px 16px; margin-bottom: 14px;
  }
  .rebate h3 { margin-bottom: 8px; }
  .rebate p { color: var(--slate-2); font-size: .95rem; margin: 0; }
  .rebate--gone { background: var(--bg-alt); }
  .rebate--gone h3 { color: var(--muted); }
  .rebate--gone p { color: var(--muted); }
  .rebate__amount--gone { background: var(--bg-deep); color: var(--muted); }

  .fstep { text-align: left; }
  .fstep__num {
    display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    background: linear-gradient(145deg, var(--orange-bright), var(--orange-deep)); color: #fff;
    font-family: var(--font-head); font-weight: 700; font-size: 1.15rem; margin-bottom: 14px;
  }
  .fstep p { color: var(--muted); font-size: .94rem; margin: 0; }
  .fin-ctas { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-top: 40px; }

  .fin-monthly { max-width: 720px; margin: 0 auto; }
  .fin-monthly ul { list-style: none; padding: 0; margin: 0 0 32px; }
  .fin-monthly li { padding: 14px 0 14px 34px; position: relative; border-bottom: 1px solid var(--line); color: var(--slate-2); }
  .fin-monthly li::before { content: "✓"; position: absolute; left: 0; color: var(--orange); font-weight: 800; font-size: 1.1rem; }
  .fin-monthly strong { color: var(--slate); }
  .fin-monthly .fin-ctas { margin-top: 0; }
  .fin-ctas__or { margin-top: 14px; color: var(--muted); font-size: .95rem; }
  .fin-ctas__or a { color: var(--orange-deep); font-weight: 600; }
</style>
