---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { primaryServices } from "../data/services";

// Bound as an expression so the regex backslashes survive into the HTML attribute.
const phonePattern = "\\(\\d{3}\\)-\\d{3}-\\d{4}";

const metaDesc = `Contact Promax Service Group for HVAC help in San Jose — free estimates on AC, heating and water heaters. Open 7 days. Call ${site.phone}.`;
const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: `Contact ${site.name}`,
  description: metaDesc,
  url: `${site.url}/contact`,
  mainEntity: { "@id": `${site.url}/#business` },
};
---
<Layout title={`Contact ${site.name} | Free HVAC Estimates San Jose`} description={metaDesc}>
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} is:inline />

  <section class="section">
    <div class="container contact">
      <div class="contact__info">
        <span class="eyebrow">Contact Details</span>
        <h1>Contact Our San Jose HVAC Team</h1>
        <p>Choosing a local technician from Promax Service Group means quick response times, personalized service, and cost-effective solutions without compromising quality. We're available 7 days a week.</p>

        <ul class="contact__list">
          <li><span aria-hidden="true">📞</span><div><strong>Phone</strong><a href={site.phoneHref}>{site.phone}</a></div></li>
          <li><span aria-hidden="true">✉️</span><div><strong>Email</strong><a href={`mailto:${site.email}`}>{site.email}</a></div></li>
          <li><span aria-hidden="true">🏢</span><div><strong>Address</strong><a href={site.sameAs[0]} target="_blank" rel="noopener">{site.address.street}, {site.address.locality}, {site.address.region} {site.address.postalCode}</a></div></li>
          <li><span aria-hidden="true">🕑</span><div><strong>Hours</strong>{site.hours}</div></li>
          <li><span aria-hidden="true">📍</span><div><strong>Service Area</strong>{site.serviceArea}</div></li>
          <li><span aria-hidden="true">📜</span><div><strong>License</strong>{site.license}</div></li>
        </ul>
        <div class="contact__certs">
          {site.certifications.map((c) => <span>✓ {c}</span>)}
        </div>
      </div>

      <div class="contact__form card">
        <div class="contact__form-head">
          <h3>Request Service</h3>
          <a href={site.bookingUrl} target="_blank" rel="noopener" class="btn btn--outline contact__book">Book Online</a>
        </div>
        <p class="contact__note">{site.promises.callback}.</p>
        <!-- Leads are POSTed to site.formEndpoint (see src/data/site.ts for the
             5-minute setup). Until it's configured, submitting reveals a
             fallback panel (Book Online / Call / email) instead of relying
             on a mailto: link, which silently does nothing on devices with
             no mail client configured. -->
        <form id="contact-form" method="POST" data-endpoint={site.formEndpoint} data-email={site.email} data-phone={site.phone} data-booking={site.bookingUrl}>
          <p class="hp" aria-hidden="true"><label>Leave this empty: <input name="_gotcha" tabindex="-1" autocomplete="off" /></label></p>
          <div class="field"><label>Name<input type="text" name="name" autocomplete="name" required /></label></div>
          <div class="field"><label>Phone<input type="tel" name="phone" id="phone" inputmode="numeric" pattern={phonePattern} placeholder="(xxx)-xxx-xxxx" title="Enter a 10-digit US phone number" autocomplete="tel" maxlength="14" required /></label></div>
          <div class="field"><label>Email<input type="email" name="email" /></label></div>
          <div class="field">
            <label>Service Needed
              <select name="service" required>
                <option value="" disabled selected>Select a service…</option>
                {primaryServices.map((s) => <option value={s.name}>{s.name}</option>)}
                <option value="Other">Other</option>
              </select>
            </label>
          </div>
          <div class="field"><label>How can we help?<textarea name="message" rows="4"></textarea></label></div>
          <button type="submit" class="btn btn--primary" id="contact-submit">Send Request</button>
          <p class="contact__status" id="contact-status" role="alert" hidden></p>
        </form>

        <div class="contact__fallback" id="contact-fallback" hidden>
          <p class="contact__fallback-lead">Fastest way: book online (2 minutes)</p>
          <a class="btn btn--primary btn--lg" id="contact-fallback-book" href={site.bookingUrl} target="_blank" rel="noopener">Book Online Now</a>
          <p class="contact__fallback-or">or call <a href={site.phoneHref}>{site.phone}</a></p>
          <a class="contact__fallback-email" id="contact-fallback-email" href="#">Email us your request instead</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Phone formatting + lead submission (endpoint or fallback panel) -->
  <script is:inline>
    (function () {
      var p = document.getElementById("phone");
      if (!p) return;
      p.addEventListener("input", function () {
        var d = this.value.replace(/\D/g, "");
        if (d.length === 11 && d[0] === "1") d = d.slice(1);
        d = d.slice(0, 10);
        this.value =
          d.length > 6 ? "(" + d.slice(0, 3) + ")-" + d.slice(3, 6) + "-" + d.slice(6) :
          d.length > 3 ? "(" + d.slice(0, 3) + ")-" + d.slice(3) :
          d.length > 0 ? "(" + d.slice(0, 3) : "";
      });

      var form = document.getElementById("contact-form");
      var status = document.getElementById("contact-status");
      var submit = document.getElementById("contact-submit");
      var fallback = document.getElementById("contact-fallback");
      var fallbackEmail = document.getElementById("contact-fallback-email");

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        if (!form.reportValidity()) return;
        if (form._gotcha && form._gotcha.value) return; // bot

        var data = {
          _subject: "New service request (website contact form)",
          name: form.name.value.trim(),
          phone: form.phone.value.trim(),
          email: form.email.value.trim(),
          service: form.service.value,
          message: form.message.value.trim(),
          source: "promax-service.com/contact",
        };

        var endpoint = form.dataset.endpoint || "";
        if (!endpoint || endpoint.indexOf("YOUR_FORM_ID") !== -1) {
          // Endpoint isn't configured yet — a mailto: link silently does
          // nothing on devices with no mail client, so show a working
          // fallback (Book Online / Call) instead, with the mailto kept
          // only as a small secondary option.
          var body = Object.keys(data).filter(function (k) { return k !== "_subject"; })
            .map(function (k) { return k + ": " + data[k]; }).join("\n");
          fallbackEmail.href = "mailto:" + form.dataset.email +
            "?subject=" + encodeURIComponent(data._subject) +
            "&body=" + encodeURIComponent(body);
          form.hidden = true;
          fallback.hidden = false;
          fallback.scrollIntoView({ behavior: "smooth", block: "nearest" });
          return;
        }

        submit.disabled = true;
        submit.textContent = "Sending…";
        fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(data),
        }).then(function (res) {
          if (!res.ok) throw new Error(res.status);
          location.href = "/thank-you";
        }).catch(function () {
          submit.disabled = false;
          submit.textContent = "Send Request";
          status.hidden = false;
          status.textContent = "Something went wrong. Please call us at " + form.dataset.phone + " — we answer 7 days a week.";
        });
      });
    })();
  </script>
</Layout>

<style>
  .contact { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  /* page h1 sits in a column, so it reads at section scale rather than hero scale */
  .contact__info h1 { font-size: clamp(2rem, 3.8vw, 3rem); }
  .contact__list { list-style: none; padding: 0; margin: 24px 0; }
  .contact__list li { display: flex; gap: 14px; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .contact__list span { font-size: 1.4rem; }
  .contact__list div { display: flex; flex-direction: column; }
  .contact__list strong { font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .contact__list a { color: var(--orange-deep); font-weight: 600; }
  .contact__certs { display: flex; flex-wrap: wrap; gap: 10px; }
  .contact__certs span { background: var(--bg-alt); border-radius: 999px; padding: 6px 14px; font-size: .85rem; color: var(--slate-2); }
  .contact__form-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-bottom: 4px; }
  .contact__form-head h3 { margin-bottom: 0; }
  .contact__book { padding: 10px 18px; min-height: 40px; font-size: .88rem; }
  .contact__note { color: var(--muted); font-size: .92rem; }

  /* success-style fallback panel (shown instead of a mailto dead-end while
     site.formEndpoint is still the "YOUR_FORM_ID" placeholder) */
  .contact__fallback {
    text-align: center; margin-top: 8px; padding: 26px 22px; border-radius: var(--radius-lg);
    background: var(--orange-soft); border: 1px solid var(--line);
  }
  .contact__fallback-lead { font-family: var(--font-head); font-weight: 700; color: var(--slate); font-size: 1.1rem; margin-bottom: 16px; }
  .contact__fallback .btn { width: 100%; max-width: 360px; }
  .contact__fallback-or { color: var(--slate-2); font-size: .95rem; margin: 14px 0 4px; }
  .contact__fallback-or a { font-weight: 700; }
  .contact__fallback-email { display: inline-block; margin-top: 10px; font-size: .85rem; color: var(--muted); text-decoration: underline; }
  .field { margin-bottom: 14px; }
  .field label { display: flex; flex-direction: column; gap: 6px; font-weight: 600; color: var(--slate); font-size: .9rem; }
  .field input, .field select, .field textarea {
    font: inherit; padding: 11px 14px; border: 1px solid var(--line); border-radius: 10px; background: #fff;
  }
  .field input:focus, .field select:focus, .field textarea:focus { outline: 2px solid var(--orange); border-color: var(--orange); }
  .hp { position: absolute; left: -9999px; opacity: 0; height: 0; overflow: hidden; }
  .contact__status { margin-top: 14px; color: var(--slate); background: var(--orange-soft); border-radius: 10px; padding: 12px 16px; font-size: .93rem; }
  .field select:invalid { color: var(--muted); }
  .field select option { color: var(--slate); }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }
</style>
