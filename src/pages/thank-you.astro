---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---
<Layout title={`Thank You | ${site.name}`} description="Your request has been received — we'll get back to you shortly." noindex>
  <section class="section">
    <div class="container ty">
      <span class="ty__icon">✅</span>
      <h1>Request Received!</h1>
      <p class="lead">
        Thanks for reaching out to {site.name}. Our team will contact you shortly —
        usually within 1–2 business days.
      </p>
      <p>Need help sooner? We answer the phone 7 days a week, {site.hours}.</p>
      <div class="ty__btns">
        <a href={site.phoneHref} class="btn btn--primary">Call {site.phone}</a>
        <a href="/" class="btn btn--outline">Back to Home</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .ty { text-align: center; max-width: 640px; padding-top: 40px; padding-bottom: 40px; }
  .ty__icon { font-size: 3.4rem; display: block; margin-bottom: 18px; }
  .ty__btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-top: 26px; }
</style>
