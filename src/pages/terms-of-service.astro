---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---
<Layout title={`Terms of Service | ${site.name}`} description="The terms that govern your use of the Promax Service Group website and the HVAC services we provide in San Jose and the Bay Area.">
  <section class="section prose">
    <div class="container" style="max-width:820px">
      <h1>Terms of Service</h1>
      <p class="lead">Please read these Terms of Use carefully before using our website or services.</p>

      <h2>Acceptance of Terms</h2>
      <p>By accessing or using our website, you agree to be bound by these Terms of Use. If you disagree with any part of these terms, you may not use our services.</p>

      <h2>Use of the Website</h2>
      <p>You agree to use the website only for lawful purposes and in a way that does not infringe upon the rights of others or inhibit their use of the website.</p>

      <h2>Intellectual Property</h2>
      <p>All content on this website, including text, graphics, logos, and software, is our property and protected by intellectual property laws.</p>

      <h2>Links to Other Websites</h2>
      <p>Our website may contain links to third-party websites. We have no control over, and assume no responsibility for, the content or practices of any third-party sites.</p>

      <h2>Disclaimers</h2>
      <p>Our services are provided "as is" without any warranties, express or implied.</p>

      <h2>Limitation of Liability</h2>
      <p>We are not liable for any damages resulting from the use of our website or services.</p>

      <h2>Termination</h2>
      <p>We may terminate or suspend your access to our services immediately, without prior notice, for any reason whatsoever.</p>

      <h2>Changes to Terms</h2>
      <p>We reserve the right to modify these terms at any time. We will notify users of any changes by updating the "Last updated" date of these Terms.</p>

      <h2>Contact Us</h2>
      <p>If you have any questions about these Terms, please contact us at <a href={site.phoneHref}>{site.phone}</a>.</p>
      <p><em>Last updated: September 2, 2024</em></p>
    </div>
  </section>
</Layout>

<style>
  /* section headings are <h2> for correct document outline — sized like the
     old h3 so the page reads the same */
  .prose h2 {
    font-family: var(--font-head); font-size: 1.2rem; font-weight: 700;
    letter-spacing: 0; line-height: 1.3; margin-top: 1.6em; color: var(--slate);
  }
  .prose p { color: var(--muted); }
</style>
