---
import Layout from "../layouts/Layout.astro";
import CallBanner from "../components/CallBanner.astro";
import Reviews from "../components/Reviews.astro";
import { site } from "../data/site";
import { locations } from "../data/locations";

const title = "Emergency HVAC Repair San Jose | Same-Day Service | Promax";
const metaDesc =
  "HVAC emergency in San Jose? No heat, no cooling, or a leaking water heater — call (669) 777-1997. Same-day service, 7 days a week, 7 AM–10 PM.";

const emergencySchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Emergency HVAC Repair in San Jose",
  serviceType: "Emergency heating, cooling and water heater repair",
  description: metaDesc,
  url: `${site.url}/emergency`,
  provider: { "@id": `${site.url}/#business` },
  areaServed: [{ "@type": "City", name: "San Jose" }, ...locations.map((l) => ({ "@type": "City", name: l.city }))],
  hoursAvailable: { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"], opens: "07:00", closes: "22:00" },
};

const situations = [
  ["No heat on a cold night", "Furnace won't ignite, blows cold air, or keeps shutting off — we prioritize homes with kids, seniors, and medical needs."],
  ["AC down in a heat wave", "When it's 100° out, a dead AC is a safety issue, not a comfort issue. Same-day priority dispatch."],
  ["Water heater leaking", "A leaking tank can fail suddenly and flood. Shut off the water supply and call — no-hot-water calls get same-day service, 7 days a week."],
  ["Gas smell near the furnace", "Leave the house first, call PG&E at 1-800-743-5000, then call us to inspect and repair the system safely."],
  ["Thermostat / system dead", "Blank thermostat, tripping breakers, burning smells — stop running the system and have it diagnosed before damage spreads."],
  ["Frozen AC or refrigerant leak", "Ice on the lines means shut it down. Running a frozen system destroys the compressor — the most expensive part."],
];
---
<Layout title={title} description={metaDesc}>
  <script type="application/ld+json" set:html={JSON.stringify(emergencySchema)} is:inline />

  <!-- call-first hero -->
  <section class="em-hero">
    <div class="container em-hero__inner">
      <span class="em-hero__badge">⚡ {site.hours}</span>
      <h1>HVAC Emergency? We're On It.</h1>
      <p>{site.promises.repair}.</p>
      <div class="em-hero__ctas">
        <a href={site.phoneHref} class="em-hero__call">
          <span class="em-hero__call-label">Tap to call now</span>
          <strong>{site.phone}</strong>
        </a>
        <a href={site.bookingUrl} class="em-hero__book" target="_blank" rel="noopener">Book Online →</a>
      </div>
      <p class="em-hero__alt">Prefer text-style booking? <a href="/contact">Send a request</a> and mark it urgent.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">When to Call</span>
        <h2>These Count as Emergencies — Don't Wait</h2>
        <p>Small failures become expensive ones fast. Here's what we rush to, and what to do before we arrive.</p>
      </div>
      <div class="grid cols-3">
        {situations.map(([t, d]) => (
          <div class="card em-card reveal">
            <h3>{t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Emergency Repairs</span>
        <h2>We Handle These Emergencies Every Day</h2>
        <p>Same urgency, different system — here's exactly what we fix, with same-day priority.</p>
      </div>
      <div class="grid cols-3">
        <a href="/services/air-conditioner-repair" class="card em-link reveal">
          <h3>AC Not Cooling</h3>
          <p>Emergency air conditioner repair →</p>
        </a>
        <a href="/services/furnace-repair" class="card em-link reveal">
          <h3>No Heat</h3>
          <p>Emergency furnace repair →</p>
        </a>
        <a href="/services/water-heater-repair" class="card em-link reveal">
          <h3>No Hot Water / Leaking Tank</h3>
          <p>Emergency water heater repair →</p>
        </a>
        <a href="/services/heat-pump-repair" class="card em-link reveal">
          <h3>Heat Pump Down</h3>
          <p>Emergency heat pump repair →</p>
        </a>
        <a href="/services/mini-split-repair" class="card em-link reveal">
          <h3>Mini Split Not Working</h3>
          <p>Emergency ductless mini split repair →</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container em-promise reveal">
      <h2>Our Emergency Promise</h2>
      <ul>
        <li><strong>A human answers.</strong> {site.hours} — no phone trees, no "leave a message."</li>
        <li><strong>Same-day priority.</strong> {site.promises.repair}, with priority for seniors, infants, and medical needs.</li>
        <li><strong>Stocked trucks.</strong> Capacitors, igniters, motors, and common parts on board — most emergency repairs finish in one visit.</li>
        <li><strong>No weekend surcharge.</strong> Saturday and Sunday cost the same as Tuesday. Emergencies don't respect business hours; neither do our rates.</li>
        <li><strong>{site.promises.diagnostic}.</strong> Approve the fix and the visit is free.</li>
      </ul>
      <div class="em-promise-ctas">
        <a href={site.phoneHref} class="btn btn--primary">Call {site.phone}</a>
        <a href={site.bookingUrl} class="btn btn--outline" target="_blank" rel="noopener">Book Online</a>
      </div>
    </div>
  </section>

  <Reviews />
  <CallBanner heading="Comfort can't wait? Call now — we answer." />
</Layout>

<style>
  .em-hero { background: linear-gradient(150deg, var(--bg-darker), var(--bg-dark)); color: #fff; text-align: center; padding: 84px 0 72px; }
  .em-hero__inner { max-width: 760px; margin: 0 auto; }
  .em-hero__badge {
    display: inline-block; background: rgba(234,88,12,.16); border: 1px solid rgba(249,115,22,.4);
    color: #fdba74; font-weight: 600; font-size: .86rem; border-radius: var(--pill); padding: 8px 18px; margin-bottom: 22px;
  }
  .em-hero h1 { color: #fff; font-size: clamp(2.2rem, 5vw, 3.6rem); }
  .em-hero p { color: var(--ondark-muted); font-size: 1.12rem; max-width: 560px; margin: 12px auto 28px; }
  .em-hero__call {
    display: inline-flex; flex-direction: column; align-items: center; gap: 2px;
    background: linear-gradient(135deg, var(--orange-bright), var(--orange-deep)); color: #fff;
    border-radius: 20px; padding: 18px 46px; box-shadow: 0 18px 44px rgba(234,88,12,.45);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .em-hero__call:hover { transform: translateY(-3px); box-shadow: 0 24px 54px rgba(234,88,12,.55); }
  .em-hero__call-label { font-size: .82rem; text-transform: uppercase; letter-spacing: .08em; opacity: .9; }
  .em-hero__call strong { font-family: var(--font-head); font-weight: 800; font-size: clamp(1.6rem, 4vw, 2.2rem); }
  .em-hero__ctas { display: flex; align-items: center; justify-content: center; gap: 18px; flex-wrap: wrap; }
  .em-hero__book {
    color: #fdba74; font-family: var(--font-head); font-weight: 700; font-size: 1.02rem;
    text-decoration: underline; text-underline-offset: 3px;
  }
  .em-hero__book:hover { color: #fff; }
  .em-hero__alt { margin-top: 22px !important; font-size: .92rem !important; }
  .em-hero__alt a { color: #fdba74; font-weight: 600; text-decoration: underline; }

  .em-card h3 { font-size: 1.05rem; }
  .em-card p { color: var(--muted); font-size: .93rem; margin: 0; }

  .em-link { display: block; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; }
  .em-link:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .em-link h3 { font-size: 1.05rem; color: var(--slate); }
  .em-link p { color: var(--orange-deep); font-weight: 700; font-size: .92rem; margin: 0; }

  .em-promise { max-width: 820px; }
  .em-promise ul { list-style: none; padding: 0; margin: 20px 0 0; }
  .em-promise li { padding: 13px 0 13px 34px; position: relative; border-bottom: 1px solid var(--line); color: var(--slate-2); }
  .em-promise li::before { content: "✓"; position: absolute; left: 0; color: var(--orange); font-weight: 800; font-size: 1.1rem; }
  .em-promise strong { color: var(--slate); }
  .em-promise-ctas { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 28px; }
</style>
