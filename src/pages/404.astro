---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { primaryServices } from "../data/services";
---
<Layout title={`Page Not Found | ${site.name}`} description="Sorry, that page doesn't exist. Find HVAC services, our work portfolio, and contact info for Promax Service Group." noindex>
  <section class="section">
    <div class="container nf">
      <span class="nf__code">404</span>
      <h1>That page took the day off.</h1>
      <p class="lead">The page you're looking for doesn't exist or has moved. Here's where you probably want to go:</p>
      <div class="nf__btns">
        <a href="/" class="btn btn--primary">Home</a>
        <a href="/#services" class="btn btn--outline">Our Services</a>
        <a href="/our-work" class="btn btn--outline">Our Work</a>
        <a href="/contact" class="btn btn--outline">Contact Us</a>
      </div>
      <div class="nf__services">
        <h2>Popular services</h2>
        <ul>
          {primaryServices.slice(0, 6).map((s) => (
            <li><a href={`/services/${s.slug}`}>{s.name}</a></li>
          ))}
        </ul>
      </div>
      <p>Or just call us — we're open 7 days a week: <a href={site.phoneHref}><strong>{site.phone}</strong></a></p>
    </div>
  </section>
</Layout>

<style>
  .nf { text-align: center; max-width: 720px; padding-top: 30px; padding-bottom: 30px; }
  .nf__code { font-family: var(--font-display); font-size: 6rem; font-weight: 700; color: var(--orange); line-height: 1; display: block; margin-bottom: 10px; }
  .nf__btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin: 26px 0 40px; }
  .nf__services h2 { font-size: 1.3rem; margin-bottom: 14px; }
  .nf__services ul { list-style: none; padding: 0; margin: 0 0 30px; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .nf__services a { background: var(--bg-alt); border: 1px solid var(--line); border-radius: var(--pill); padding: 8px 18px; font-size: .92rem; color: var(--slate); display: inline-block; transition: .18s ease; }
  .nf__services a:hover { background: var(--orange); border-color: var(--orange); color: #fff; }
</style>
