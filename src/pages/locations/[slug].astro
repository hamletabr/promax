---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Stages from "../../components/Stages.astro";
import CallBanner from "../../components/CallBanner.astro";
import FAQ from "../../components/FAQ.astro";
import { locations } from "../../data/locations";
import { primaryServices } from "../../data/services";
import { site } from "../../data/site";

export function getStaticPaths() {
  return locations.map((l) => ({ params: { slug: l.slug }, props: { loc: l } }));
}
const { loc } = Astro.props;

const pageUrl = `${site.url}/locations/${loc.slug}`;
const metaDesc = `${loc.sub} Licensed HVAC repair, installation & maintenance in ${loc.city}, CA — open 7 days a week. Free estimates. Call ${site.phone}.`;
const locationSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: loc.h1,
  serviceType: "HVAC repair, installation and maintenance",
  description: metaDesc,
  url: pageUrl,
  provider: { "@id": `${site.url}/#business` },
  areaServed: { "@type": "City", name: loc.city },
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    { "@type": "ListItem", position: 2, name: "Locations", item: `${site.url}/#locations` },
    { "@type": "ListItem", position: 3, name: loc.city, item: pageUrl },
  ],
};

const issues = [
  ["No Cooling or Heating", "Fast diagnostics and repair of compressors, pilots, and ignition systems."],
  ["Strange Noises", "Fan motor servicing, vibration isolation, and component lubrication for quiet operation."],
  ["Air Quality Concerns", "Filtration upgrades and ventilation solutions to combat smoke and allergens."],
  ["High Energy Bills", "Efficiency audits, smart thermostats, and system tune-ups to reduce costs."],
  ["Uneven Temperatures", "Zoning, duct balancing, and thermostat recalibration for uniform comfort."],
  ["Frequent Cycling", "Thermostat calibration and component checks to prevent short-cycling."],
];
---
<Layout title={loc.title} description={metaDesc}>
  <script type="application/ld+json" set:html={JSON.stringify(locationSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

  <PageHero
    eyebrow="Local Technicians"
    title={loc.h1}
    sub={loc.sub}
    image="/images/photo_loc-min.jpg"
    parentLabel="Locations"
    parentHref="/#locations"
    current={loc.city}
  />

  <section class="section">
    <div class="container loc-intro">
      <span class="eyebrow">Serving {loc.city}</span>
      <h2>Your Local HVAC Team in {loc.city}</h2>
      <p>{loc.sub} Our certified technicians deliver same-day support, expert installations, preventive maintenance, indoor air quality solutions, and smart controls &amp; zoning — all backed by transparent, upfront pricing.</p>
      <ul class="loc-feats">
        <li><strong>Same-Day Support</strong> — emergency and scheduled service, day or night.</li>
        <li><strong>Expert Installations</strong> — AC, heating, ductless splits, and heat pumps.</li>
        <li><strong>Preventive Maintenance</strong> — filter changes, tune-ups, and system optimization.</li>
        <li><strong>Indoor Air Quality</strong> — HEPA filters, UV lights, and ERV/HRV ventilation.</li>
        <li><strong>Smart Controls &amp; Zoning</strong> — Wi-Fi thermostats and multi-zone damper systems.</li>
      </ul>
      <a href={site.phoneHref} class="btn btn--outline">Call {site.phone}</a>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Common HVAC Issues</span>
        <h2>What We Fix in {loc.city}</h2>
      </div>
      <div class="grid cols-3">
        {issues.map(([t, d]) => (
          <div class="card benefit">
            <h3>✓ {t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CallBanner heading={`Trusted HVAC service in ${loc.city} — call today.`} />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our Services</span>
        <h2>HVAC Services Available in {loc.city}</h2>
      </div>
      <div class="grid cols-4">
        {primaryServices.slice(0, 8).map((s) => (
          <a href={`/services/${s.slug}`} class="card rel">
            <h3>{s.name}</h3>
            <span class="rel__link">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Stages />
  <FAQ />
</Layout>

<style>
  .promo-strip { margin-top: 36px; }
  .loc-intro { max-width: 820px; }
  .loc-feats { list-style: none; padding: 0; margin: 0 0 24px; }
  .loc-feats li { padding: 10px 0 10px 30px; position: relative; border-bottom: 1px solid var(--line); color: var(--muted); }
  .loc-feats li::before { content: "✓"; position: absolute; left: 0; color: var(--orange); font-weight: 700; }
  .loc-feats strong { color: var(--slate); }
  .benefit h3 { color: var(--slate); font-size: 1.05rem; }
  .benefit p { color: var(--muted); font-size: .94rem; margin: 0; }
  .rel__link { color: var(--orange); font-weight: 600; font-size: .9rem; }
</style>
