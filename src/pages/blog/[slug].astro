---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CallBanner from "../../components/CallBanner.astro";
import EstimateButton from "../../components/EstimateButton.astro";
import CallButton from "../../components/CallButton.astro";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = `${site.url}/blog/${post.id}`;

const postSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  image: `${site.url}${post.data.image}`,
  url,
  author: { "@type": "Organization", name: site.name, url: site.url },
  publisher: { "@id": `${site.url}/#business` },
  mainEntityOfPage: url,
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${site.url}/blog` },
    { "@type": "ListItem", position: 3, name: post.data.title, item: url },
  ],
};

const fmt = (d: Date) => d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
const related = (await getCollection("blog"))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Layout title={`${post.data.title} | Promax Service Group`} description={post.data.description} ogImage={post.data.image}>
  <script type="application/ld+json" set:html={JSON.stringify(postSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

  <article class="section bpost">
    <div class="container bpost__wrap">
      <nav class="bpost__crumb"><a href="/">Home</a> / <a href="/blog">Blog</a></nav>
      <div class="bpost__tags">{post.data.tags.map((t) => <span>{t}</span>)}</div>
      <h1>{post.data.title}</h1>
      <p class="bpost__meta">{fmt(post.data.date)} · by {site.name}</p>
      <img class="bpost__hero" src={post.data.image} alt={post.data.title} width="880" height="460" />
      <div class="bpost__content">
        <Content />
      </div>

      <div class="bpost__cta">
        <h2>Ready for real numbers?</h2>
        <p>Get an instant ballpark for your home, or talk to a licensed local pro — free, 7 days a week.</p>
        <div class="bpost__cta-btns">
          <CallButton />
          <EstimateButton label="Get My Instant Estimate" />
        </div>
      </div>

      {related.length > 0 && (
        <aside class="bpost__related">
          <h2>Keep reading</h2>
          <ul>
            {related.map((r) => (
              <li><a href={`/blog/${r.id}`}>{r.data.title}</a></li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </article>

  <CallBanner heading="Have a question this article didn't answer? Just call — we love this stuff." />
</Layout>

<style>
  .bpost__wrap { max-width: 820px; }
  .bpost__crumb { font-size: .85rem; color: var(--muted); margin-bottom: 18px; }
  .bpost__crumb a { color: var(--orange-deep); font-weight: 600; }
  .bpost__tags { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
  .bpost__tags span { background: var(--orange-soft); color: var(--orange-deep); font-size: .74rem; font-weight: 700; border-radius: var(--pill); padding: 5px 13px; }
  .bpost h1 { font-size: clamp(1.7rem, 3.6vw, 2.5rem); }
  .bpost__meta { color: var(--muted); font-size: .9rem; margin-bottom: 24px; }
  .bpost__hero { border-radius: var(--radius); box-shadow: var(--shadow); margin-bottom: 34px; width: 100%; object-fit: cover; aspect-ratio: 16/8; }

  .bpost__content :global(h2) { font-size: 1.45rem; margin-top: 1.6em; }
  .bpost__content :global(p) { color: var(--slate-2); line-height: 1.75; }
  .bpost__content :global(li) { color: var(--slate-2); margin-bottom: .4em; line-height: 1.65; }
  .bpost__content :global(a) { color: var(--orange-deep); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .bpost__content :global(table) { width: 100%; border-collapse: collapse; margin: 1.2em 0; font-size: .92rem; }
  .bpost__content :global(th), .bpost__content :global(td) { border: 1px solid var(--line); padding: 10px 14px; text-align: left; }
  .bpost__content :global(th) { background: var(--bg-alt); font-family: var(--font-head); color: var(--slate); }
  .bpost__content :global(strong) { color: var(--slate); }

  .bpost__cta {
    margin-top: 44px; background: var(--bg-dark); border-radius: var(--radius-lg);
    padding: 36px; text-align: center;
  }
  .bpost__cta h2 { color: #fff; margin-bottom: 6px; }
  .bpost__cta p { color: var(--ondark-muted); margin-bottom: 22px; }
  .bpost__cta-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

  .bpost__related { margin-top: 40px; border-top: 1px solid var(--line); padding-top: 28px; }
  .bpost__related h2 { font-size: 1.2rem; margin-bottom: 12px; }
  .bpost__related ul { list-style: none; padding: 0; margin: 0; }
  .bpost__related li { margin-bottom: 10px; }
  .bpost__related a { color: var(--orange-deep); font-weight: 600; }
  .bpost__related a:hover { text-decoration: underline; }
</style>
