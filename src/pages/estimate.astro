---
import Layout from "../layouts/Layout.astro";
import CallBanner from "../components/CallBanner.astro";
import { site } from "../data/site";
import { sqftTiers, floorOptions, priorityOptions, ductPricing, disclaimer } from "../data/estimator";

const title = "Free Instant HVAC Estimate | San Jose, CA | Promax Service Group";
const metaDesc =
  "Get an instant ballpark price for your HVAC installation in San Jose. Answer 4 quick questions — house size, floors, priorities, ductwork — and see your range now.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    { "@type": "ListItem", position: 2, name: "Free Estimate", item: `${site.url}/estimate` },
  ],
};

// passed to the client script
const config = {
  sqftTiers,
  floorOptions,
  priorityOptions,
  ductPricing,
  endpoint: site.formEndpoint,
  email: site.email,
  phone: site.phone,
};
---
<Layout title={title} description={metaDesc}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

  <section class="est-hero">
    <div class="container est-hero__inner">
      <span class="eyebrow">Online Estimator</span>
      <h1>Get Your HVAC Price Range in 60 Seconds</h1>
      <p>Answer four quick questions and see a real ballpark price for your San Jose home — no waiting, no pressure, no obligation.</p>
    </div>
  </section>

  <section class="section est-section">
    <div class="container">
      <div class="est card" id="est" data-config={JSON.stringify(config)}>

        <!-- progress -->
        <div class="est__progress" aria-hidden="true">
          <div class="est__bar"><span id="est-bar"></span></div>
          <span class="est__stepcount"><b id="est-stepnum">1</b> / 5</span>
        </div>

        <!-- STEP 1: sqft -->
        <fieldset class="est__step" data-step="1">
          <legend><h2>How big is your home?</h2></legend>
          <p class="est__hint">Approximate living area that needs heating &amp; cooling.</p>
          <div class="est__opts" role="radiogroup" aria-label="Square footage">
            {sqftTiers.map((t, i) => (
              <button type="button" class="est__opt" data-field="sqft" data-value={i}>
                <strong>{t.label}</strong>
                <span>{t.sub}</span>
              </button>
            ))}
          </div>
        </fieldset>

        <!-- STEP 2: floors -->
        <fieldset class="est__step" data-step="2" hidden>
          <legend><h2>How many floors?</h2></legend>
          <p class="est__hint">Multi-story homes often benefit from zoning — we'll factor that into your visit.</p>
          <div class="est__opts est__opts--3" role="radiogroup" aria-label="Number of floors">
            {floorOptions.map((f) => (
              <button type="button" class="est__opt" data-field="floors" data-value={f}>
                <strong>{f}</strong>
              </button>
            ))}
          </div>
        </fieldset>

        <!-- STEP 3: priorities -->
        <fieldset class="est__step" data-step="3" hidden>
          <legend><h2>What matters most to you?</h2></legend>
          <p class="est__hint">Pick as many as you like — this helps us recommend the right equipment.</p>
          <div class="est__opts est__opts--chips" role="group" aria-label="Priorities">
            {priorityOptions.map((p) => (
              <button type="button" class="est__opt est__opt--chip" data-field="priority" data-value={p}>
                <strong>{p}</strong>
              </button>
            ))}
          </div>
        </fieldset>

        <!-- STEP 4: ductwork -->
        <fieldset class="est__step" data-step="4" hidden>
          <legend><h2>Does your ductwork need to be replaced?</h2></legend>
          <p class="est__hint">Old, leaky, or crushed ducts waste up to 30% of the air you pay to heat and cool.</p>
          <div class="est__opts est__opts--3" role="radiogroup" aria-label="Ductwork replacement">
            <button type="button" class="est__opt" data-field="ductwork" data-value="yes"><strong>Yes</strong><span>Replace the ducts</span></button>
            <button type="button" class="est__opt" data-field="ductwork" data-value="no"><strong>No</strong><span>Ducts are fine</span></button>
            <button type="button" class="est__opt" data-field="ductwork" data-value="unsure"><strong>Not sure</strong><span>We'll check on-site</span></button>
          </div>
          <div class="est__ducts" id="est-ducts" hidden>
            <label for="duct-count"><strong>How many ducts (vents) are in the house?</strong></label>
            <p class="est__hint">Count the supply registers in floors, walls, or ceilings. Each duct adds ${ductPricing.perDuctLow.toLocaleString()}–${ductPricing.perDuctHigh.toLocaleString()}.</p>
            <div class="est__stepper">
              <button type="button" id="duct-minus" aria-label="Fewer ducts">−</button>
              <input type="number" id="duct-count" min={ductPricing.min} max={ductPricing.max} value="8" inputmode="numeric" aria-label="Number of ducts" />
              <button type="button" id="duct-plus" aria-label="More ducts">+</button>
            </div>
          </div>
        </fieldset>

        <!-- STEP 5: result + lead form -->
        <fieldset class="est__step" data-step="5" hidden>
          <legend><h2>Your Estimated Price Range</h2></legend>
          <div class="est__result">
            <span class="est__range" id="est-range" aria-live="polite">$0 – $0</span>
            <p class="est__summary" id="est-summary"></p>
            <p class="est__disclaimer">{disclaimer}</p>
          </div>

          <form id="est-form" novalidate>
            <h3>Lock in your free on-site quote</h3>
            <p class="est__hint">Send us your answers and we'll confirm the exact price — usually within 1 business day.</p>
            <div class="est__fields">
              <div class="field">
                <label for="lead-name">Name *<input id="lead-name" type="text" name="name" autocomplete="name" required /></label>
                <span class="field__err" hidden>Please enter your name</span>
              </div>
              <div class="field">
                <label for="lead-phone">Phone *<input id="lead-phone" type="tel" name="phone" inputmode="numeric" autocomplete="tel" placeholder="(xxx)-xxx-xxxx" maxlength="14" required /></label>
                <span class="field__err" hidden>Please enter a 10-digit phone number</span>
              </div>
              <div class="field">
                <label for="lead-email">Email<input id="lead-email" type="email" name="email" autocomplete="email" /></label>
              </div>
              <div class="field">
                <label for="lead-city">City<input id="lead-city" type="text" name="city" autocomplete="address-level2" placeholder="San Jose" /></label>
              </div>
            </div>
            <p class="hp" aria-hidden="true"><label>Leave this empty: <input name="_gotcha" tabindex="-1" autocomplete="off" /></label></p>
            <button type="submit" class="btn btn--primary btn--lg" id="est-submit">Send My Estimate Request</button>
            <p class="est__formstatus" id="est-status" role="alert" hidden></p>
          </form>
        </fieldset>

        <!-- nav -->
        <div class="est__nav">
          <button type="button" class="est__back" id="est-back" hidden>← Back</button>
          <button type="button" class="btn btn--primary" id="est-next" disabled>Continue →</button>
        </div>
      </div>

      <p class="est__alt">Prefer to talk it through? Call <a href={site.phoneHref}>{site.phone}</a> — open 7 days a week.</p>
    </div>
  </section>

  <!-- SEO copy -->
  <section class="section section--alt">
    <div class="container est-seo">
      <h2>How Our Instant HVAC Estimate Works</h2>
      <p>
        Most HVAC companies in San Jose make you wait days for a ballpark number. Our online estimator uses real pricing
        from hundreds of completed Promax installations across Santa Clara County — sized by your home's square footage,
        with ductwork replacement priced per duct — so you know what to expect before anyone steps in your door.
        The final quote is always confirmed with a <strong>free on-site assessment</strong>, and as a Mitsubishi Diamond
        Contractor and Bryant Premier Dealer we'll also check whether federal tax credits or income-qualified HEEHRA rebates can lower your cost.
      </p>
    </div>
  </section>

  <CallBanner heading="Want an exact number today? Call us — free estimates, 7 days a week." />
</Layout>

<script>
  const root = document.getElementById("est")!;
  const cfg = JSON.parse(root.dataset.config!);

  type State = {
    sqft: number | null;
    floors: string | null;
    priorities: string[];
    ductwork: string | null;
    ducts: number;
  };
  const state: State = { sqft: null, floors: null, priorities: [], ductwork: null, ducts: 8 };

  const steps = Array.from(root.querySelectorAll<HTMLElement>(".est__step"));
  const nextBtn = document.getElementById("est-next") as HTMLButtonElement;
  const backBtn = document.getElementById("est-back") as HTMLButtonElement;
  const bar = document.getElementById("est-bar")!;
  const stepnum = document.getElementById("est-stepnum")!;
  const ductPanel = document.getElementById("est-ducts")!;
  const ductInput = document.getElementById("duct-count") as HTMLInputElement;
  let step = 1;

  const money = (n: number) => "$" + n.toLocaleString("en-US");

  function range(): [number, number] {
    if (state.sqft === null) return [0, 0];
    const tier = cfg.sqftTiers[state.sqft];
    let lo = tier.low, hi = tier.high;
    if (state.ductwork === "yes") {
      lo += state.ducts * cfg.ductPricing.perDuctLow;
      hi += state.ducts * cfg.ductPricing.perDuctHigh;
    }
    return [lo, hi];
  }

  function valid(): boolean {
    if (step === 1) return state.sqft !== null;
    if (step === 2) return state.floors !== null;
    if (step === 3) return true; // priorities optional
    if (step === 4) return state.ductwork !== null;
    return true;
  }

  function render(scroll = true) {
    for (const s of steps) s.hidden = Number(s.dataset.step) !== step;
    bar.style.width = `${(step / 5) * 100}%`;
    stepnum.textContent = String(step);
    backBtn.hidden = step === 1;
    nextBtn.hidden = step === 5;
    nextBtn.disabled = !valid();
    if (step === 5) renderResult();
    if (scroll) root.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function renderResult() {
    const [lo, hi] = range();
    document.getElementById("est-range")!.textContent = `${money(lo)} – ${money(hi)}`;
    const tier = cfg.sqftTiers[state.sqft!];
    const parts = [
      `${tier.label} · ${state.floors}`,
      state.ductwork === "yes"
        ? `ductwork replacement (${state.ducts} ducts)`
        : state.ductwork === "unsure"
          ? "ductwork checked on-site"
          : "existing ductwork kept",
    ];
    if (state.priorities.length) parts.push(`priorities: ${state.priorities.join(", ")}`);
    document.getElementById("est-summary")!.textContent = parts.join(" · ");
  }

  // option selection
  root.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>(".est__opt");
    if (!btn) return;
    const { field, value } = btn.dataset as { field: string; value: string };

    if (field === "priority") {
      btn.classList.toggle("is-picked");
      const v = value;
      state.priorities = btn.classList.contains("is-picked")
        ? [...state.priorities, v]
        : state.priorities.filter((p) => p !== v);
    } else {
      btn.parentElement!.querySelectorAll(".est__opt").forEach((b) => b.classList.remove("is-picked"));
      btn.classList.add("is-picked");
      if (field === "sqft") state.sqft = Number(value);
      if (field === "floors") state.floors = value;
      if (field === "ductwork") {
        state.ductwork = value;
        ductPanel.hidden = value !== "yes";
      }
    }
    nextBtn.disabled = !valid();
  });

  nextBtn.addEventListener("click", () => { if (valid() && step < 5) { step++; render(); } });
  backBtn.addEventListener("click", () => { if (step > 1) { step--; render(); } });

  // duct stepper
  const clampDucts = () => {
    const v = Math.min(cfg.ductPricing.max, Math.max(cfg.ductPricing.min, Number(ductInput.value) || cfg.ductPricing.min));
    ductInput.value = String(v);
    state.ducts = v;
  };
  document.getElementById("duct-minus")!.addEventListener("click", () => { ductInput.value = String(Number(ductInput.value) - 1); clampDucts(); });
  document.getElementById("duct-plus")!.addEventListener("click", () => { ductInput.value = String(Number(ductInput.value) + 1); clampDucts(); });
  ductInput.addEventListener("input", clampDucts);

  // phone live-format
  const phoneEl = document.getElementById("lead-phone") as HTMLInputElement;
  phoneEl.addEventListener("input", function () {
    const d = this.value.replace(/[^0-9]/g, "").slice(0, 10);
    this.value =
      d.length > 6 ? `(${d.slice(0, 3)})-${d.slice(3, 6)}-${d.slice(6)}` :
      d.length > 3 ? `(${d.slice(0, 3)})-${d.slice(3)}` :
      d.length > 0 ? `(${d.slice(0, 3)}` : "";
  });

  // submit lead
  const form = document.getElementById("est-form") as HTMLFormElement;
  const status = document.getElementById("est-status")!;
  const submitBtn = document.getElementById("est-submit") as HTMLButtonElement;

  function leadPayload() {
    const [lo, hi] = range();
    const tier = cfg.sqftTiers[state.sqft!];
    return {
      _subject: "New HVAC estimate request (website estimator)",
      name: (document.getElementById("lead-name") as HTMLInputElement).value.trim(),
      phone: phoneEl.value.trim(),
      email: (document.getElementById("lead-email") as HTMLInputElement).value.trim(),
      city: (document.getElementById("lead-city") as HTMLInputElement).value.trim(),
      "house size": tier.label,
      floors: state.floors,
      priorities: state.priorities.join(", ") || "(none selected)",
      "ductwork replacement": state.ductwork === "yes" ? `Yes — ${state.ducts} ducts` : state.ductwork,
      "estimate shown": `${money(lo)} – ${money(hi)}`,
      source: "promax-service.com/estimate",
    };
  }

  function showError(input: HTMLInputElement, show: boolean) {
    const err = input.closest(".field")?.querySelector<HTMLElement>(".field__err");
    if (err) err.hidden = !show;
    input.classList.toggle("is-invalid", show);
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const nameEl = document.getElementById("lead-name") as HTMLInputElement;
    const nameOk = nameEl.value.trim().length > 0;
    const phoneOk = phoneEl.value.replace(/[^0-9]/g, "").length === 10;
    showError(nameEl, !nameOk);
    showError(phoneEl, !phoneOk);
    if (!nameOk || !phoneOk) { (!nameOk ? nameEl : phoneEl).focus(); return; }

    const gotcha = form.querySelector<HTMLInputElement>('[name="_gotcha"]');
    if (gotcha?.value) return; // bot

    const payload = leadPayload();
    const configured = cfg.endpoint && !cfg.endpoint.includes("YOUR_FORM_ID");

    if (!configured) {
      // graceful fallback until the form endpoint is set up: open email app
      const body = Object.entries(payload)
        .filter(([k]) => k !== "_subject")
        .map(([k, v]) => `${k}: ${v}`)
        .join("\n");
      location.href = `mailto:${cfg.email}?subject=${encodeURIComponent(payload._subject)}&body=${encodeURIComponent(body)}`;
      status.hidden = false;
      status.textContent = `Your email app should open with your request. If it didn't, just call us at ${cfg.phone}.`;
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "Sending…";
    try {
      const res = await fetch(cfg.endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(String(res.status));
      location.href = "/thank-you";
    } catch {
      submitBtn.disabled = false;
      submitBtn.textContent = "Send My Estimate Request";
      status.hidden = false;
      status.textContent = `Something went wrong sending your request. Please call us at ${cfg.phone} — we answer 7 days a week.`;
    }
  });

  render(false);
</script>

<style>
  .est-hero { background: var(--bg-dark); color: #fff; padding: 72px 0 56px; }
  .est-hero .eyebrow { color: #fff; }
  .est-hero__inner { max-width: 720px; text-align: center; margin: 0 auto; }
  .est-hero h1 { color: #fff; font-size: clamp(1.9rem, 4vw, 2.9rem); }
  .est-hero p { color: var(--ondark-muted, #b3b3ba); font-size: 1.08rem; margin: 12px auto 0; max-width: 560px; }

  .est-section { padding-top: 48px; }
  .est { max-width: 780px; margin: 0 auto; padding: 34px clamp(20px, 4vw, 44px) 38px; }
  .est:hover { transform: none; box-shadow: var(--shadow-sm); }

  .est__progress { display: flex; align-items: center; gap: 14px; margin-bottom: 28px; }
  .est__bar { flex: 1; height: 8px; border-radius: 99px; background: var(--bg-alt); overflow: hidden; }
  .est__bar span { display: block; height: 100%; width: 20%; border-radius: 99px; background: linear-gradient(90deg, var(--orange), var(--amber)); transition: width .3s ease; }
  .est__stepcount { font-size: .85rem; color: var(--muted); font-weight: 600; white-space: nowrap; }

  .est__step { border: 0; padding: 0; margin: 0; }
  .est__step legend h2 { font-size: clamp(1.3rem, 2.6vw, 1.7rem); margin-bottom: 4px; }
  .est__hint { color: var(--muted); font-size: .95rem; margin-bottom: 20px; }

  .est__opts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .est__opts--3 { grid-template-columns: repeat(3, 1fr); }
  .est__opts--chips { display: flex; flex-wrap: wrap; }
  .est__opt {
    font: inherit; text-align: left; cursor: pointer; min-height: 64px;
    background: #fff; border: 2px solid var(--line); border-radius: 14px;
    padding: 14px 18px; display: flex; flex-direction: column; gap: 2px;
    transition: border-color .18s ease, background .18s ease, transform .18s ease;
  }
  .est__opt:hover { border-color: var(--orange); transform: translateY(-2px); }
  .est__opt:focus-visible { outline: 3px solid var(--orange); outline-offset: 2px; }
  .est__opt.is-picked { border-color: var(--orange); background: var(--orange-soft); }
  .est__opt strong { font-family: var(--font-head); font-weight: 600; color: var(--slate); font-size: 1rem; }
  .est__opt span { font-size: .84rem; color: var(--muted); }
  .est__opt--chip { flex-direction: row; align-items: center; min-height: 48px; border-radius: 99px; padding: 10px 20px; }

  .est__ducts { margin-top: 22px; padding: 20px; border-radius: 14px; background: var(--bg-alt); }
  .est__ducts label { font-family: var(--font-head); color: var(--slate); }
  .est__ducts .est__hint { margin-bottom: 12px; }
  .est__stepper { display: inline-flex; align-items: center; gap: 0; border: 2px solid var(--line); border-radius: 12px; overflow: hidden; background: #fff; }
  .est__stepper button {
    font: inherit; font-size: 1.4rem; font-weight: 700; color: var(--orange);
    width: 52px; height: 52px; border: 0; background: none; cursor: pointer;
  }
  .est__stepper button:hover { background: var(--orange-soft); }
  .est__stepper input {
    font: inherit; font-family: var(--font-head); font-weight: 700; font-size: 1.2rem; color: var(--slate);
    width: 72px; height: 52px; text-align: center; border: 0; border-left: 2px solid var(--line); border-right: 2px solid var(--line);
    -moz-appearance: textfield; appearance: textfield;
  }
  .est__stepper input::-webkit-outer-spin-button, .est__stepper input::-webkit-inner-spin-button { -webkit-appearance: none; }

  .est__result { text-align: center; padding: 10px 0 26px; border-bottom: 1px solid var(--line); margin-bottom: 26px; }
  .est__range { font-family: var(--font-head); font-weight: 700; font-size: clamp(2.1rem, 5vw, 3rem); color: var(--orange); display: block; }
  .est__summary { color: var(--slate-2); font-size: .93rem; margin: 10px 0 14px; }
  .est__disclaimer { color: var(--muted); font-size: .82rem; max-width: 560px; margin: 0 auto; }

  .est__fields { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 18px 0; }
  .field label { display: flex; flex-direction: column; gap: 6px; font-weight: 600; color: var(--slate); font-size: .9rem; }
  .field input { font: inherit; padding: 12px 14px; border: 2px solid var(--line); border-radius: 10px; background: #fff; min-height: 48px; }
  .field input:focus { outline: 2px solid var(--orange); border-color: var(--orange); }
  .field input.is-invalid { border-color: #dc2626; }
  .field__err { color: #dc2626; font-size: .82rem; margin-top: 4px; display: block; }
  .hp { position: absolute; left: -9999px; opacity: 0; height: 0; overflow: hidden; }

  .est__formstatus { margin-top: 14px; color: var(--slate); background: var(--orange-soft); border-radius: 10px; padding: 12px 16px; font-size: .93rem; }

  .est__nav { display: flex; justify-content: space-between; align-items: center; gap: 14px; margin-top: 30px; }
  .est__back { font: inherit; font-weight: 600; color: var(--muted); background: none; border: 0; cursor: pointer; padding: 12px 6px; min-height: 44px; }
  .est__back:hover { color: var(--orange-deep); }
  .est__nav .btn { margin-left: auto; }
  .btn:disabled { opacity: .45; cursor: not-allowed; transform: none !important; box-shadow: none; }

  .est__alt { text-align: center; color: var(--muted); margin-top: 22px; }
  .est__alt a { font-weight: 700; color: var(--orange-deep); }

  .est-seo { max-width: 860px; }

  [hidden] { display: none !important; }

  @media (max-width: 640px) {
    .est__opts, .est__opts--3, .est__fields { grid-template-columns: 1fr; }
    .est__nav .btn { width: 100%; }
    .est__nav { flex-direction: column-reverse; }
    .est__nav .est__back { margin-right: auto; }
  }
</style>
