---
import { site } from "../data/site";
const { heading } = Astro.props;
---
<section class="callban">
  <div class="container callban__inner">
    <div>
      <span class="callban__eyebrow">We Work Every Day · 7:00 AM – 10:00 PM</span>
      <p class="callban__title">{heading ?? "Need HVAC help today? We're ready."}</p>
    </div>
    <div class="callban__cta">
      <span>Call Us Today!</span>
      <a href={site.phoneHref}>{site.phone}</a>
      <a href={site.bookingUrl} class="callban__book" target="_blank" rel="noopener">or Book Online →</a>
    </div>
  </div>
</section>

<style>
  .callban { background: var(--orange-soft); color: var(--slate); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .callban__inner { display: flex; align-items: center; justify-content: space-between; gap: 28px; padding: 38px 20px; flex-wrap: wrap; }
  .callban__eyebrow { text-transform: uppercase; letter-spacing: .1em; font-size: .8rem; font-weight: 600; color: var(--orange-deep); }
  /* A call to action, not a content section — a <p> styled exactly like the h2 it replaced. */
  .callban__title {
    font-family: var(--font-display); font-weight: 700; line-height: 1.05; letter-spacing: -0.01em;
    text-wrap: balance; color: var(--slate); margin: 8px 0 0; font-size: clamp(1.5rem, 2.6vw, 2rem);
  }
  .callban__cta { text-align: right; }
  .callban__cta span { display: block; font-size: .85rem; color: var(--muted); }
  .callban__cta a { font-family: var(--font-head); font-weight: 800; font-size: 1.9rem; color: var(--orange); }
  .callban__cta a:hover { color: var(--orange-deep); }
  .callban__cta .callban__book {
    display: block; margin-top: 4px; font-family: var(--font-body);
    font-weight: 700; font-size: .92rem; color: var(--orange-deep);
    text-decoration: underline; text-underline-offset: 3px;
  }
  .callban__cta .callban__book:hover { color: var(--orange-hover); }
  @media (max-width: 640px) { .callban__cta { text-align: left; } }
</style>
