---
// Floating AI chat (bottom-right, on every page).
// - LLM: Google Gemini free tier when site.ai.geminiApiKey is set (see
//   src/data/site.ts for the 5-minute setup). Without a key, a built-in
//   assistant answers from site data (services, hours, price ranges).
// - Leads: the "Send to our team" flow posts the transcript + contact info to
//   site.formEndpoint (same pipeline as the estimator/contact form). While
//   the endpoint isn't configured yet, it shows a Book Online + Call fallback
//   instead of a lead form that would have nowhere real to go.
import { site } from "../data/site";
import { sqftTiers, ductPricing } from "../data/estimator";

const priceLines = sqftTiers.map((t) => `${t.label}: $${t.low.toLocaleString()}–$${t.high.toLocaleString()}`).join("; ");
const formConfigured = !!site.formEndpoint && !site.formEndpoint.includes("YOUR_FORM_ID");
// Typical parts-and-labor range for a common repair (capacitor, igniter,
// blower motor, contactor, etc.) — not a full-installation price.
const repairRange = "$150–$650";

const systemPrompt = `You are the friendly virtual assistant for ${site.name}, a licensed HVAC contractor (${site.license}) in San Jose, CA.
Business facts: phone ${site.phone}; email ${site.email}; hours ${site.hours}; service area: San Jose, Santa Clara, Sunnyvale, Cupertino, Campbell, Milpitas, Mountain View, Palo Alto and the greater Bay Area.
Services: AC repair/installation/maintenance, furnace repair/installation, heat pumps, ductless mini splits (Mitsubishi Diamond Contractor), VRF/VRV systems, Bryant systems (Bryant Factory Authorized Dealer), ductwork, zoning, indoor air quality, tank/tankless/heat-pump water heaters (Navien specialist).
Typical FULL-INSTALLATION ballpark ranges by home size: ${priceLines}. Ductwork replacement adds about $${ductPricing.perDuctLow}–$${ductPricing.perDuctHigh} per duct. A typical REPAIR (capacitor, igniter, blower motor, contactor, etc.) instead runs about ${repairRange} — always ask whether the visitor needs a repair or a new system before quoting a price, and never give an installation price when they're describing a repair (broken, not working, warm air, no heat, no hot water, leak, noise, etc.).
Response times & fees — quote these exactly, word for word, and never invent your own numbers or timeframes: repair calls: "${site.promises.repair}." Other scheduled visits: "${site.promises.scheduled}." Callbacks: "${site.promises.callback}." Diagnostic fee: "${site.promises.diagnostic}." New-system estimates: "${site.promises.estimate}."
Rebates — state these precisely: the federal 25C tax credit (30% up to $2,000/yr) EXPIRED for installations completed after December 31, 2025 — never say it is currently available. HEEHRA (income-qualified) single-family funding is fully reserved statewide; we can add the household to a waitlist and apply it if funds return. TECH Clean California rebate funding is currently EXHAUSTED. For any rebate question, say we check every rebate and incentive the visitor qualifies for at their free estimate.
Rules: Be warm, concise (2-4 sentences), and practical. Never invent prices beyond the ranges above. For anything urgent or specific, recommend calling ${site.phone} (${site.hours}) or booking online. If the visitor wants a callback, a quote, or a human, ask for their name and phone number, then tell them to tap "Send to our team" below the chat so our staff receives the conversation. Only discuss topics related to HVAC, home comfort, and this company.`;

const config = {
  endpoint: site.formEndpoint,
  formConfigured,
  email: site.email,
  phone: site.phone,
  phoneHref: site.phoneHref,
  bookingUrl: site.bookingUrl,
  systemPrompt,
  gemini: site.ai,
  // facts for the built-in (no-API-key) assistant
  facts: {
    hours: site.hours,
    priceLines: sqftTiers.map((t) => `${t.label}: $${t.low.toLocaleString()}–$${t.high.toLocaleString()}`),
    perDuct: `$${ductPricing.perDuctLow}–$${ductPricing.perDuctHigh}`,
    repairRange,
    promises: site.promises,
  },
};
---
<div class="chatw" id="chatw" data-config={JSON.stringify(config)}>
  <!-- floating button -->
  <button class="chatw__fab" id="chatw-fab" aria-label="Chat with us" aria-expanded="false" aria-controls="chatw-panel">
    <svg class="chatw__fab-open" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
    <svg class="chatw__fab-close" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
      <path d="M18 6 6 18M6 6l12 12"/>
    </svg>
  </button>

  <!-- panel -->
  <section class="chatw__panel" id="chatw-panel" role="dialog" aria-label="Promax chat assistant" hidden>
    <header class="chatw__head">
      <div>
        <strong>Promax Assistant</strong>
        <span>Ask about services, pricing &amp; scheduling</span>
      </div>
      <div class="chatw__head-actions">
        <a href={site.bookingUrl} class="chatw__call chatw__book" target="_blank" rel="noopener" aria-label="Book online">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/></svg>
          Book
        </a>
        <a href={site.phoneHref} class="chatw__call" aria-label={`Call ${site.phone}`}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.3 11.3 0 0 0 3.55.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.3a1 1 0 0 1 1 1 11.3 11.3 0 0 0 .57 3.55 1 1 0 0 1-.24 1Z"/></svg>
          Call
        </a>
      </div>
    </header>

    <div class="chatw__msgs" id="chatw-msgs" aria-live="polite"></div>

    <div class="chatw__quick" id="chatw-quick">
      <button type="button" data-q="How much would a new HVAC system cost for my home?">💲 Ballpark price</button>
      <button type="button" data-q="What areas do you serve and what are your hours?">📍 Areas & hours</button>
      <button type="button" data-q="I'd like a callback from your team.">👤 Talk to a human</button>
    </div>

    <form class="chatw__inputrow" id="chatw-form">
      <label class="sr-only" for="chatw-input">Type your message</label>
      <input id="chatw-input" type="text" placeholder="Type your question…" autocomplete="off" maxlength="500" />
      <button type="submit" class="chatw__send" aria-label="Send message">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
      </button>
    </form>

    <footer class="chatw__foot">
      <button type="button" class="chatw__tolead" id="chatw-tolead">✉ Send this conversation to our team</button>
    </footer>

    <!-- lead capture overlay -->
    <div class="chatw__lead" id="chatw-lead" hidden>
      <h3>Send to our team</h3>
      {formConfigured ? (
        <form id="chatw-leadform">
          <p>We'll get the whole conversation and follow up — usually within 1 business day.</p>
          <label for="chatw-name">Name *<input id="chatw-name" type="text" autocomplete="name" required /></label>
          <label for="chatw-phone">Phone *<input id="chatw-phone" type="tel" inputmode="numeric" placeholder="(xxx)-xxx-xxxx" maxlength="14" autocomplete="tel" required /></label>
          <label for="chatw-email">Email<input id="chatw-email" type="email" autocomplete="email" /></label>
          <div class="chatw__lead-btns">
            <button type="button" id="chatw-leadback">Back</button>
            <button type="submit" class="chatw__lead-send" id="chatw-leadsend">Send</button>
          </div>
          <p class="chatw__leadstatus" id="chatw-leadstatus" role="alert" hidden></p>
        </form>
      ) : (
        <div class="chatw__lead-fallback">
          <p>The fastest way to reach a real person: book your appointment online, or call us directly.</p>
          <div class="chatw__lead-ctas">
            <a href={site.bookingUrl} class="chatw__lead-send" target="_blank" rel="noopener">Book Online →</a>
            <a href={site.phoneHref} class="chatw__lead-callbtn">Call {site.phone}</a>
          </div>
          <button type="button" id="chatw-leadback" class="chatw__lead-back">Back</button>
        </div>
      )}
    </div>
  </section>
</div>

<script>
  const root = document.getElementById("chatw")!;
  const cfg = JSON.parse(root.dataset.config!);
  const fab = document.getElementById("chatw-fab") as HTMLButtonElement;
  const panel = document.getElementById("chatw-panel")!;
  const msgsEl = document.getElementById("chatw-msgs")!;
  const quick = document.getElementById("chatw-quick")!;
  const form = document.getElementById("chatw-form") as HTMLFormElement;
  const input = document.getElementById("chatw-input") as HTMLInputElement;
  const leadPane = document.getElementById("chatw-lead")!;

  type Msg = { role: "user" | "assistant"; content: string };
  const STORE = "promax-chat";
  let history: Msg[] = [];
  try { history = JSON.parse(sessionStorage.getItem(STORE) || "[]"); } catch {}

  const GREETING =
    "Hi! I'm the Promax assistant 👋 Ask me anything about heating, cooling, water heaters, pricing, or scheduling in the San Jose area.";

  function save() { try { sessionStorage.setItem(STORE, JSON.stringify(history.slice(-30))); } catch {} }

  function bubble(role: "user" | "assistant", text: string) {
    const div = document.createElement("div");
    div.className = `chatw__msg chatw__msg--${role}`;
    div.textContent = text;
    msgsEl.appendChild(div);
    msgsEl.scrollTop = msgsEl.scrollHeight;
    return div;
  }

  function renderHistory() {
    msgsEl.innerHTML = "";
    bubble("assistant", GREETING);
    for (const m of history) bubble(m.role, m.content);
  }

  // ── LLM: Google Gemini free tier (when a key is configured in site.ts) ──
  const hasGemini = !!cfg.gemini?.geminiApiKey;

  async function askGemini(question: string): Promise<string> {
    const url = `https://generativelanguage.googleapis.com/v1beta/models/${cfg.gemini.model}:generateContent?key=${cfg.gemini.geminiApiKey}`;
    const contents = [
      ...history.slice(-12).map((m) => ({ role: m.role === "user" ? "user" : "model", parts: [{ text: m.content }] })),
      { role: "user", parts: [{ text: question }] },
    ];
    const res = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        systemInstruction: { parts: [{ text: cfg.systemPrompt }] },
        contents,
        generationConfig: { maxOutputTokens: 512, temperature: 0.6 },
      }),
    });
    if (!res.ok) throw new Error(String(res.status));
    const data = await res.json();
    const text = data?.candidates?.[0]?.content?.parts?.map((p: any) => p.text).join("") ?? "";
    if (!text) throw new Error("empty response");
    return text.trim();
  }

  // ── Built-in assistant: answers from site data (no API key needed) ──
  function localAnswer(q: string): string {
    const s = q.toLowerCase();
    const f = cfg.facts;
    // Repair intent is checked FIRST, before the price/cost pattern below —
    // otherwise "my AC is blowing warm air, how much to fix?" matches "how
    // much" and answers with a full-installation price instead of a repair one.
    if (/(repair|fix|broken|not cooling|warm air|not working|no heat|no hot water|leak|noise)/.test(s))
      return `That sounds like a repair, not a new system — most common fixes (a failed capacitor, igniter, blower motor, or contactor) run about ${f.repairRange}, and ${f.promises.diagnostic.toLowerCase()}. ${f.promises.repair}. Call ${cfg.phone} or tap Book above and we'll get a tech out to diagnose it.`;
    if (/(price|cost|how much|quote|estimate|ballpark|\$)/.test(s))
      return `Typical full-installation ranges: ${f.priceLines.join(" · ")}. Ductwork replacement adds about ${f.perDuct} per duct. ${f.promises.estimate}. Try our online estimator at promax-service.com/estimate, tap Book above, or call ${cfg.phone}.`;
    if (/(hour|open|when|schedule|weekend|sunday|saturday|today)/.test(s))
      return `We're open ${f.hours} — including weekends, at no extra charge. ${f.promises.scheduled} Call ${cfg.phone} or tap Book above any time.`;
    if (/(area|serve|where|city|location|come to|near)/.test(s))
      return `We serve San Jose and the greater Bay Area — Santa Clara, Sunnyvale, Cupertino, Campbell, Milpitas, Mountain View, Los Gatos, Palo Alto, Fremont, and more. If you're nearby, we've got you covered — call ${cfg.phone} to confirm.`;
    if (/(mitsubishi|mini split|ductless|multi.?zone|single.?zone)/.test(s))
      return `Yes — we're a Mitsubishi Diamond Contractor (their highest certification) and install single-zone and multi-zone ductless mini splits, ideal for ADUs, additions, and homes without ducts. See real installs at promax-service.com/our-work.`;
    if (/(bryant|carrier|furnace|heater|heating)/.test(s))
      return `We're a Bryant Factory Authorized Dealer and service all major brands. We handle furnace repair, replacement, and high-efficiency (96% AFUE) installations, with a carbon-monoxide safety check on every heating visit. Call ${cfg.phone} — ${f.hours}.`;
    if (/(water heater|tankless|hot water|navien)/.test(s))
      return `We repair, replace, and install tank, tankless, and heat-pump water heaters (Navien Service Specialists). ${f.promises.repair} No hot water? Call ${cfg.phone} for fast service.`;
    if (/(duct|vent|airflow)/.test(s))
      return `We design, replace, seal, and balance ductwork — replacement runs about ${f.perDuct} per duct. Leaky ducts waste up to 30% of the air you pay for, so it's often the best-value fix for uneven rooms and high bills.`;
    if (/(rebate|tax credit|heehra|tech clean|incentive|financing)/.test(s))
      return `The federal 25C tax credit ended for installations after 2025, and HEEHRA's income-qualified single-family funding is fully reserved statewide right now — we can add you to the waitlist and apply it if funds return. We check every rebate and incentive you qualify for at your free estimate, and financing is available too.`;
    if (/(human|person|callback|call me|agent|someone|representative|staff)/.test(s))
      return `Absolutely — tap "Send this conversation to our team" just below and leave your name and number. ${f.promises.callback} Or call us right now at ${cfg.phone}, or tap Book above.`;
    if (/(emergency|urgent)/.test(s))
      return `Sorry you're dealing with that! ${f.promises.repair}. Call ${cfg.phone} now and we'll prioritize you.`;
    if (/(hi|hello|hey|thanks|thank you)/.test(s))
      return `Happy to help! Ask me about pricing, services, rebates, or scheduling — or get an instant price range at promax-service.com/estimate.`;
    return `Great question! I can help with pricing, services (AC, heating, heat pumps, mini splits, water heaters, ducts), rebates, and scheduling. For anything specific, call ${cfg.phone} (${f.hours}), tap Book above, or tap "Send this conversation to our team" below and our staff will follow up.`;
  }

  async function ask(question: string) {
    history.push({ role: "user", content: question });
    save();
    bubble("user", question);
    quick.hidden = true;

    const typing = bubble("assistant", "…");
    typing.classList.add("chatw__msg--typing");

    let text: string;
    try {
      text = hasGemini ? await askGemini(question) : localAnswer(question);
    } catch {
      text = localAnswer(question);
    }
    typing.classList.remove("chatw__msg--typing");
    typing.textContent = text;
    history.push({ role: "assistant", content: text });
    save();
    msgsEl.scrollTop = msgsEl.scrollHeight;
  }

  // ── open/close ──
  function toggle(open?: boolean) {
    const willOpen = open ?? panel.hidden === true;
    panel.hidden = !willOpen;
    root.classList.toggle("is-open", willOpen);
    fab.setAttribute("aria-expanded", String(willOpen));
    if (willOpen) {
      renderHistory();
      quick.hidden = history.length > 0;
      input.focus();
    }
  }
  fab.addEventListener("click", () => toggle());
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !panel.hidden) toggle(false);
  });

  // On narrow screens the FAB sits right over the hero's Call button (and
  // any hero CTA on other pages). Hide it while that hero is in view; the
  // CSS below only applies this at ≤760px, and never while the chat is open.
  const heroEl = document.querySelector(".hero, .phero");
  if (heroEl) {
    const heroIO = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) root.classList.toggle("chatw--hero-visible", entry.isIntersecting);
      },
      { threshold: 0.12 }
    );
    heroIO.observe(heroEl);
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const q = input.value.trim();
    if (!q) return;
    input.value = "";
    ask(q);
  });

  quick.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-q]");
    if (btn) ask(btn.dataset.q!);
  });

  // ── lead capture: send the transcript to the team ──
  // cfg.formConfigured mirrors formConfigured at build time. When it's false
  // the markup above renders a Book Online + Call fallback instead of a form
  // that would otherwise go nowhere, so no lead form exists to wire up here.
  const leadForm = document.getElementById("chatw-leadform") as HTMLFormElement | null;
  const leadStatus = document.getElementById("chatw-leadstatus");
  const leadSend = document.getElementById("chatw-leadsend") as HTMLButtonElement | null;
  const leadPhone = document.getElementById("chatw-phone") as HTMLInputElement | null;

  document.getElementById("chatw-tolead")!.addEventListener("click", () => {
    leadPane.hidden = false;
    const name = document.getElementById("chatw-name") as HTMLInputElement | null;
    name?.focus();
  });
  document.getElementById("chatw-leadback")!.addEventListener("click", () => { leadPane.hidden = true; });

  leadPhone?.addEventListener("input", function () {
    const d = this.value.replace(/[^0-9]/g, "").slice(0, 10);
    this.value =
      d.length > 6 ? `(${d.slice(0, 3)})-${d.slice(3, 6)}-${d.slice(6)}` :
      d.length > 3 ? `(${d.slice(0, 3)})-${d.slice(3)}` :
      d.length > 0 ? `(${d.slice(0, 3)}` : "";
  });

  leadForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!leadForm.reportValidity() || !leadPhone || !leadSend || !leadStatus) return;
    const transcript = history.map((m) => `${m.role === "user" ? "Visitor" : "Assistant"}: ${m.content}`).join("\n") || "(no messages — visitor requested contact)";
    const payload = {
      _subject: "New chat lead (website AI assistant)",
      name: (document.getElementById("chatw-name") as HTMLInputElement).value.trim(),
      phone: leadPhone.value.trim(),
      email: (document.getElementById("chatw-email") as HTMLInputElement).value.trim(),
      transcript,
      source: "promax-service.com (chat widget)",
    };

    leadSend.disabled = true;
    leadSend.textContent = "Sending…";
    try {
      const res = await fetch(cfg.endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(String(res.status));
      leadSend.textContent = "Sent ✓";
      leadStatus.hidden = false;
      leadStatus.textContent = "Got it! Our team will reach out shortly.";
      setTimeout(() => { leadPane.hidden = true; leadSend.disabled = false; leadSend.textContent = "Send"; leadStatus.hidden = true; }, 2600);
    } catch {
      leadSend.disabled = false;
      leadSend.textContent = "Send";
      leadStatus.hidden = false;
      leadStatus.textContent = `Couldn't send — please call us at ${cfg.phone}.`;
    }
  });
</script>

<style>
  .chatw { position: fixed; right: 18px; bottom: 18px; z-index: 90; font-family: var(--font-body); }

  /* FAB */
  .chatw__fab {
    width: 58px; height: 58px; border-radius: 50%; border: 0; cursor: pointer;
    background: linear-gradient(135deg, var(--orange-bright), var(--orange-deep));
    color: #fff; display: grid; place-items: center;
    box-shadow: 0 10px 26px rgba(234, 88, 12, .45), 0 3px 8px rgba(15, 32, 56, .2);
    transition: transform .2s ease, box-shadow .2s ease, opacity .2s ease;
  }
  .chatw__fab:hover { transform: translateY(-3px) scale(1.04); box-shadow: 0 16px 34px rgba(234, 88, 12, .55); }
  .chatw__fab:focus-visible { outline: 3px solid var(--orange); outline-offset: 3px; }
  .chatw__fab-close { display: none; }
  .is-open .chatw__fab-open { display: none; }
  .is-open .chatw__fab-close { display: block; }

  /* Panel */
  .chatw__panel {
    position: absolute; right: 0; bottom: 72px;
    width: min(370px, calc(100vw - 28px));
    background: #fff; border: 1px solid var(--line); border-radius: 18px;
    box-shadow: var(--shadow-lg);
    display: flex; flex-direction: column; overflow: hidden;
  }
  .chatw__panel[hidden] { display: none !important; }

  .chatw__head {
    background: var(--bg-dark); color: #fff;
    padding: 14px 16px; display: flex; align-items: center; justify-content: space-between; gap: 10px;
  }
  .chatw__head strong { font-family: var(--font-head); font-size: .98rem; display: block; }
  .chatw__head span { font-size: .76rem; color: var(--ondark-muted); }
  .chatw__head-actions { display: flex; align-items: center; gap: 8px; flex: none; }
  .chatw__call {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(255,255,255,.12); color: #fff; border-radius: 999px;
    padding: 8px 14px; font-size: .82rem; font-weight: 600; min-height: 36px;
  }
  .chatw__call:hover { background: var(--orange-deep); }
  .chatw__book { background: var(--orange-deep); }
  .chatw__book:hover { background: var(--orange-hover); }

  .chatw__msgs {
    height: 320px; max-height: 46vh; overflow-y: auto;
    padding: 14px; display: flex; flex-direction: column; gap: 8px;
    background: var(--bg-alt);
  }
  .chatw__msg {
    max-width: 85%; padding: 9px 13px; border-radius: 14px;
    font-size: .9rem; line-height: 1.5; white-space: pre-wrap; word-wrap: break-word;
  }
  .chatw__msg--assistant { background: #fff; border: 1px solid var(--line); color: var(--slate-2); border-bottom-left-radius: 4px; align-self: flex-start; }
  .chatw__msg--user { background: var(--orange-deep); color: #fff; border-bottom-right-radius: 4px; align-self: flex-end; }
  .chatw__msg--typing { color: var(--muted); }
  @media (prefers-reduced-motion: no-preference) {
    .chatw__msg--typing { animation: chatw-pulse 1.2s ease infinite; }
    @keyframes chatw-pulse { 50% { opacity: .45; } }
  }

  .chatw__quick { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 14px 0; background: var(--bg-alt); }
  .chatw__quick button {
    font: inherit; font-size: .8rem; font-weight: 600; cursor: pointer;
    background: #fff; color: var(--slate-2); border: 1px solid var(--line);
    border-radius: 999px; padding: 8px 13px; min-height: 36px; transition: .15s ease;
  }
  .chatw__quick button:hover { border-color: var(--orange); color: var(--orange-deep); }

  .chatw__inputrow { display: flex; gap: 8px; padding: 12px 14px; background: var(--bg-alt); }
  .chatw__inputrow input {
    flex: 1; font: inherit; font-size: .92rem; padding: 11px 14px; min-height: 44px;
    border: 1px solid var(--line); border-radius: 999px; background: #fff;
  }
  .chatw__inputrow input:focus { outline: 2px solid var(--orange); border-color: var(--orange); }
  .chatw__send {
