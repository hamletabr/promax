---
// Dark homepage band promoting financing + rebates → /financing
---
<section class="finband">
  <div class="container finband__inner reveal">
    <div class="finband__text">
      <span class="eyebrow eyebrow--band">Financing &amp; Rebates</span>
      <h2>New System? Rebates Can Cover Thousands.</h2>
      <p>
        Federal tax credits up to $2,000, income-qualified HEEHRA rebates, and monthly financing plans —
        we stack every incentive you qualify for and handle all the paperwork.
      </p>
    </div>
    <div class="finband__cta">
      <a href="/financing" class="btn btn--primary btn--lg">Explore Financing &amp; Rebates</a>
      <span>Free estimates include every rebate, itemized.</span>
    </div>
  </div>
</section>

<style>
  .finband { background: linear-gradient(140deg, var(--bg-darker), var(--bg-dark)); padding: 72px 0; }
  .finband__inner { display: flex; align-items: center; justify-content: space-between; gap: 40px; flex-wrap: wrap; }
  .finband__text { max-width: 620px; }
  .eyebrow--band { color: #fff; }
  .finband h2 { color: #fff; margin-bottom: 10px; }
  .finband p { color: var(--ondark-muted); margin: 0; }
  .finband__cta { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .finband__cta span { color: #8b8b93; font-size: .84rem; }
</style>
