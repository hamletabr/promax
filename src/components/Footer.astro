---
import { site } from "../data/site";
import { primaryServices } from "../data/services";
import { locations } from "../data/locations";

// Every primary service is listed (no cap), so a new primary page reaches the
// footer on its own. Commercial HVAC is a destination rather than a primary
// card, so it is added after the list — unless it is ever promoted to primary,
// in which case it is already in the list and is not repeated.
const commercialListed = primaryServices.some((s) => s.slug === "commercial-hvac");
---
<footer class="ftr">
  <div class="container ftr__grid">
    <div>
      <img src="/images/logo.jpg" alt={site.name} class="ftr__logo" width="328" height="100" loading="lazy" decoding="async" />
      <p class="ftr__about">
        Your local San Jose HVAC team for repair, installation, and maintenance.
        EPA certified, Mitsubishi Diamond Contractor and Bryant Factory Authorized Dealer.
      </p>
      <p class="ftr__lic">{site.license}</p>
    </div>

    <div class="ftr__svc">
      <h4>Services</h4>
      <ul class="ftr__svc-list">
        {primaryServices.map((s) => (
          <li><a href={`/services/${s.slug}`}>{s.name}</a></li>
        ))}
      </ul>
      <ul class="ftr__svc-more">
        <li><a href="/services">All services</a></li>
        {!commercialListed && <li><a href="/services/commercial-hvac">Commercial HVAC</a></li>}
        <li><a href="/emergency">Emergency Service</a></li>
      </ul>
    </div>

    <div>
      <h4>Company</h4>
      <ul>
        <li><a href="/about">About Us</a></li>
        <li><a href="/our-work">Our Work</a></li>
        <li><a href="/reviews">Reviews</a></li>
        <li><a href="/specials">Specials & Coupons</a></li>
        <li><a href="/financing">Financing & Rebates</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/estimate">Free Estimate</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>

    <div>
      <h4>Service Areas</h4>
      <ul class="ftr__areas">
        {locations.map((l) => (
          <li><a href={`/locations/${l.slug}`}>{l.city}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h4>Contact</h4>
      <p><a href={site.phoneHref} class="ftr__phone">{site.phone}</a></p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p>{site.hours}</p>
      <p>Serving {site.serviceArea}</p>
    </div>
  </div>
  <div class="ftr__bar">
    <div class="container">
      <span>© {new Date().getFullYear()} {site.name}. All rights reserved.</span>
      <span><a href="/privacy-policy">Privacy Policy</a> · <a href="/terms-of-service">Terms of Service</a></span>
    </div>
  </div>
</footer>

<style>
  .ftr { background: var(--bg-dark); color: #a1a1aa; padding-top: 60px; }
  /* The Services column is the widest: it carries every primary service in two
     columns, so it gets roughly twice the width of the other link columns. The brand
     column keeps a 180px floor so the logo (54px tall, ~177px wide) is never squeezed,
     and service areas keep the width they had before. */
  .ftr__grid { display: grid; grid-template-columns: minmax(180px, .8fr) 2.35fr .9fr 1.3fr .9fr; gap: 24px; padding-bottom: 44px; }
  .ftr__logo { height: 54px; width: auto; border-radius: 6px; margin-bottom: 16px; }
  .ftr__about { font-size: .92rem; }
  .ftr__lic { font-weight: 700; color: #fff; }
  .ftr h4 { color: #fff; font-size: 1rem; margin-bottom: 16px; }
  .ftr ul { list-style: none; margin: 0; padding: 0; }
  .ftr li { margin-bottom: 9px; }
  .ftr a { color: #a1a1aa; font-size: .92rem; }
  .ftr a:hover { color: var(--amber); }
  .ftr__areas { columns: 2; }
  .ftr__svc-list { columns: 2; column-gap: 28px; }
  .ftr__svc-list li { break-inside: avoid; }
  /* destination links under the list: All services / Commercial / Emergency */
  .ftr .ftr__svc-more { display: flex; flex-wrap: wrap; gap: 4px 20px; margin-top: 6px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,.1); }
  .ftr__svc-more li { margin-bottom: 0; }
  .ftr__svc-more a { color: #fff; font-weight: 600; }
  .ftr__svc-more a:hover { color: var(--amber); }
  .ftr__phone { color: var(--amber) !important; font-weight: 700; font-size: 1.1rem; }
  .ftr__bar { border-top: 1px solid rgba(255,255,255,.1); padding: 18px 0; font-size: .84rem; }
  .ftr__bar .container { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  /* below the 1180px container width five columns are too tight for a two-column service list:
     brand + services share the first row, the rest drop to the next */
  @media (max-width: 1179px) {
    .ftr__grid { grid-template-columns: repeat(3, 1fr); }
    .ftr__svc { grid-column: span 2; }
  }
  @media (max-width: 860px) { .ftr__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) {
    .ftr__grid { grid-template-columns: 1fr; }
    .ftr__svc { grid-column: auto; }
  }
  @media (max-width: 400px) { .ftr__svc-list { columns: 1; } }
</style>
