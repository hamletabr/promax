---
// Four differentiators, one row of icon + text (no card tiles / pastel
// backgrounds). Icons are four visually distinct marks from public/images —
// co2.png and lo1.png are the same gauge icon, so neither is used here.
const features = [
  {
    icon: "/images/co1.png",
    title: "Licensed & EPA Certified",
    text: "Fully licensed HVAC professionals, EPA-certified for safe refrigerant handling on every job.",
  },
  {
    icon: "/images/co4.png",
    title: "Upfront Pricing",
    text: "Clear, itemized quotes before we start work — no surprise charges on the invoice.",
  },
  {
    icon: "/images/lo3.png",
    title: "Our Own Employees",
    text: "Every technician who visits your home is our own trained staff — never a subcontractor.",
  },
  {
    icon: "/images/lo4.png",
    title: "Warranty on Parts & Labor",
    text: "We stand behind our work with real warranty coverage on every repair and installation.",
  },
];
---
<section class="section section--alt" id="why">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Why Choose Us</span>
      <h2>Your Comfort, Our Priority</h2>
      <p>We combine technical expertise with customer-focused care to deliver unmatched quality and satisfaction.</p>
    </div>
    <div class="wcu-row">
      {features.map((f) => (
        <div class="wcu reveal">
          <img class="wcu__icon" src={f.icon} alt="" width="40" height="40" loading="lazy" decoding="async" />
          <div class="wcu__body">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .wcu-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .wcu { display: flex; align-items: flex-start; gap: 14px; text-align: left; }
  .wcu__icon { flex: none; width: 44px; height: 44px; padding: 9px; object-fit: contain; background: var(--orange-soft); border-radius: 10px; }
  .wcu__body h3 { color: var(--slate); font-size: 1.02rem; margin-bottom: 4px; }
  .wcu__body p { color: var(--muted); font-size: .9rem; margin: 0; }
  @media (max-width: 900px) { .wcu-row { grid-template-columns: repeat(2, 1fr); gap: 28px 24px; } }
  @media (max-width: 560px) { .wcu-row { grid-template-columns: 1fr; } }
</style>
