---
// Homepage "Our Work" teaser — automatically shows the newest portfolio
// projects from src/data/portfolio.ts. Edit that file to change what appears.
import { sortedProjects, coverOf, flattenCategories } from "../data/portfolio";

const flat = flattenCategories();
const pathLabel = (path: string[]) =>
  flat.find((f) => f.path.join("/") === path.join("/"))?.fullLabel ?? path.join(" · ");

const featured = sortedProjects.slice(0, 6);
---
<section class="section" id="work">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Our Work</span>
      <h2>Recent HVAC Projects in the Bay Area</h2>
      <p>Real installs, repairs, and maintenance jobs completed by our local team — browse by category in our full portfolio.</p>
    </div>
    <div class="gallery reveal">
      {featured.map((p) => {
        const cover = coverOf(p);
        return (
          <a class="gallery__item" href={`/our-work#${p.path.join("/")}`}>
            <img src={cover.src} alt={cover.alt} loading="lazy" width="480" height="360" />
            <span class="gallery__overlay">
              <strong>{p.title}</strong>
              <span>{pathLabel(p.path)} · {p.location}</span>
            </span>
          </a>
        );
      })}
    </div>
    <div class="gallery__cta reveal">
      <a href="/our-work" class="btn btn--primary btn--lg">View Full Portfolio →</a>
    </div>
  </div>
</section>

<style>
  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .gallery__item {
    position: relative; overflow: hidden; border-radius: 14px; aspect-ratio: 4/3;
    background: var(--bg-alt); display: block;
  }
  .gallery__item img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .gallery__item:hover img { transform: scale(1.07); }
  .gallery__overlay {
    position: absolute; inset: auto 0 0 0; padding: 34px 16px 14px;
    background: linear-gradient(180deg, transparent, rgba(10,10,12,.86));
    color: #fff; display: flex; flex-direction: column; gap: 2px;
  }
  .gallery__overlay strong { font-family: var(--font-head); font-size: .95rem; line-height: 1.25; }
  .gallery__overlay span { font-size: .78rem; color: #c9c9cf; }
  .gallery__cta { text-align: center; margin-top: 34px; }
  @media (max-width: 900px) { .gallery { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .gallery { grid-template-columns: 1fr; } }
</style>
