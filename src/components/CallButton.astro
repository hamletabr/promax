---
import { site } from "../data/site";
interface Props { class?: string; }
const { class: extra = "" } = Astro.props;
---
<a href={site.phoneHref} class:list={["callbtn", extra]} aria-label={`Call ${site.name} now at ${site.phone}`}>
  <span class="callbtn__lens" aria-hidden="true">
    <span class="callbtn__ring callbtn__ring--1"></span>
    <span class="callbtn__ring callbtn__ring--2"></span>
    <svg class="callbtn__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.3 11.3 0 0 0 3.55.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.3a1 1 0 0 1 1 1 11.3 11.3 0 0 0 .57 3.55 1 1 0 0 1-.24 1Z"/></svg>
  </span>
  <span class="callbtn__label">Call Now</span>
</a>

<style>
  /* ===== Vibrant call button (solid orange) ===== */
  .callbtn {
    position: relative; display: inline-flex; align-items: center; gap: 13px;
    height: 56px; padding: 0 26px 0 8px; border-radius: 14px;
    text-decoration: none; color: #fff;
    font-family: var(--font-head); font-weight: 700; font-size: 1.0625rem; letter-spacing: .01em; line-height: 1;
    cursor: pointer; -webkit-tap-highlight-color: transparent;
    background: linear-gradient(135deg, var(--amber) 0%, var(--orange) 50%, var(--orange-deep) 100%);
    box-shadow: 0 1px 0 rgba(255,255,255,.35) inset, 0 12px 28px rgba(232,116,12,.45), 0 4px 10px rgba(184,86,0,.32);
    transition: transform .28s cubic-bezier(.2,.8,.2,1), box-shadow .28s ease, filter .28s ease;
    isolation: isolate; will-change: transform;
  }
  .callbtn__lens {
    position: relative; flex: 0 0 auto; display: grid; place-items: center;
    width: 40px; height: 40px; border-radius: 50%; color: var(--orange);
    background: #fff; box-shadow: 0 3px 8px rgba(120,50,0,.28);
    transition: transform .28s cubic-bezier(.2,.8,.2,1);
  }
  .callbtn__lens::after {
    content: ""; position: absolute; inset: 0; border-radius: 50%; pointer-events: none; z-index: 2;
    background: radial-gradient(80% 55% at 32% 22%, rgba(255,255,255,.9), transparent 60%);
  }
  .callbtn__icon { position: relative; z-index: 3; display: block; }
  .callbtn__ring {
    position: absolute; inset: 0; margin: auto; width: 40px; height: 40px; border-radius: 50%;
    border: 2px solid rgba(255,255,255,.85); opacity: 0; z-index: 1; pointer-events: none;
  }
  .callbtn__label { position: relative; white-space: nowrap; }
  .callbtn:hover {
    transform: translateY(-3px); filter: saturate(1.08) brightness(1.04);
    box-shadow: 0 1px 0 rgba(255,255,255,.4) inset, 0 18px 38px rgba(232,116,12,.55), 0 6px 14px rgba(184,86,0,.4);
  }
  .callbtn:hover .callbtn__lens, .callbtn:focus-visible .callbtn__lens { transform: scale(1.06); }
  .callbtn:active { transform: translateY(0) scale(.985); }
  .callbtn:focus-visible {
    outline: none;
    box-shadow: 0 12px 28px rgba(232,116,12,.45), 0 0 0 3px var(--bg-dark), 0 0 0 5px #fff;
  }
  @media (prefers-reduced-motion: no-preference) {
    .callbtn__ring { animation: callbtn-sonar 2.6s cubic-bezier(.2,.6,.3,1) infinite; }
    .callbtn__ring--2 { animation-delay: 1.3s; }
    .callbtn:hover .callbtn__ring { animation-duration: 1.8s; }
    .callbtn:hover .callbtn__icon, .callbtn:focus-visible .callbtn__icon { animation: callbtn-wiggle .6s cubic-bezier(.2,.8,.2,1) 1; }
    @keyframes callbtn-sonar { 0% { transform: scale(.9); opacity: 0; } 12% { opacity: .7; } 100% { transform: scale(2.0); opacity: 0; } }
    @keyframes callbtn-wiggle { 0% { transform: rotate(0); } 30% { transform: rotate(-10deg); } 65% { transform: rotate(8deg); } 100% { transform: rotate(0); } }
  }
  @media (prefers-reduced-motion: reduce) {
    .callbtn__ring { animation: none !important; }
    .callbtn__ring--1 { opacity: .3; transform: scale(1.3); }
    .callbtn__ring--2 { display: none; }
  }
  @media (max-width: 480px) { .callbtn { width: 100%; justify-content: flex-start; } }
</style>
