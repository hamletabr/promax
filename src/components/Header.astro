---
import { site, nav } from "../data/site";
---
<header class="hdr">
  
  <div class="container hdr__main">
    <a href="/" class="hdr__logo">
      <img src="/images/logo.jpg" alt={site.name} width="328" height="100" fetchpriority="high" />
    </a>
    <nav class="hdr__nav" id="nav" aria-label="Main">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <!-- Mobile-drawer-only quick actions (hidden on the desktop horizontal
           nav via CSS) so a call, a free estimate, and online booking are
           always one tap away even when the top-bar CTA is collapsed. -->
      <div class="hdr__nav-actions">
        <a href={site.phoneHref} class="hdr__nav-call">Call {site.phone}</a>
        <a href="/estimate" class="hdr__nav-est">Free Estimate</a>
        <a href={site.bookingUrl} class="hdr__nav-book" target="_blank" rel="noopener">Book Online</a>
      </div>
    </nav>
    <div class="hdr__cta">
      <a href={site.phoneHref} class="hdr__phone">
        <span class="hdr__phone-label">Call Us Today</span>
        <strong>{site.phone}</strong>
      </a>
      <a href="/estimate" class="btn btn--primary hdr__book">Free Estimate</a>
      <button class="hdr__burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav" id="burger"><span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span></button>
    </div>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: #fff; box-shadow: 0 2px 14px rgba(0,0,0,.06); }
  .hdr__top { background: var(--slate); color: #cfd6dd; font-size: .82rem; }
  .hdr__top-inner { display: flex; justify-content: space-between; padding: 8px 20px; }
  .hdr__top a { color: #cfd6dd; }
  .hdr__top-right { display: flex; gap: 22px; }
  .hdr__main { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 12px 20px; }
  .hdr__logo img { height: 56px; width: auto; border-radius: 6px; }
  .hdr__nav { display: flex; gap: 18px; margin-left: auto; }
  .hdr__nav a { color: var(--slate); font-family: var(--font-head); font-weight: 500; font-size: .9rem; white-space: nowrap; }
  .hdr__nav a:hover { color: var(--orange-deep); }
  .hdr__cta { display: flex; align-items: center; gap: 16px; }
  .hdr__phone { display: flex; flex-direction: column; line-height: 1.1; color: var(--slate); }
  .hdr__phone-label { font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
  .hdr__phone strong { font-family: var(--font-head); font-size: 1.15rem; color: var(--orange); }
  .hdr__burger { display: none; flex-direction: column; gap: 5px; background: none; border: 0; cursor: pointer; padding: 6px; }
  .hdr__burger span { width: 26px; height: 3px; background: var(--slate); border-radius: 2px; }

  .hdr__nav-actions { display: none; }

  @media (max-width: 1120px) {
    .hdr__nav {
      position: absolute; top: 100%; left: 0; right: 0; flex-direction: column;
      background: #fff; padding: 14px 20px; gap: 6px; box-shadow: var(--shadow);
      display: none; max-height: 80vh; overflow-y: auto;
    }
    .hdr__nav.open { display: flex; }
    /* Only the text nav collapses into the burger — the phone stays visible
       in the header bar at every width (see the narrower breakpoint below
       for a compact version). The filled CTA button collapses here; its
       actions move into the drawer instead (below). */
    .hdr__book { display: none; }
    .hdr__burger { display: flex; }

    .hdr__nav-actions {
      display: flex; flex-direction: column; gap: 8px;
      margin-top: 8px; padding-top: 14px; border-top: 1px solid var(--line);
    }
    .hdr__nav-actions a {
      text-align: center; border-radius: 10px; padding: 12px 16px; min-height: 44px;
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-head); font-weight: 700; font-size: .92rem;
    }
    .hdr__nav-call { background: var(--bg-alt); color: var(--slate); }
    .hdr__nav-est { background: var(--orange-deep); color: #fff; }
    .hdr__nav-est:hover { background: var(--orange-hover); }
    .hdr__nav-book { background: #fff; color: var(--ink); border: 2px solid var(--ink); }
    .hdr__nav-book:hover { background: var(--ink); color: #fff; }
  }

  /* Narrow phones: the header still needs room for logo + phone + burger,
     so drop the "Call Us Today" label and shrink the number. The link stays
     visible and tappable — nothing about the CTA disappears, it just
     compacts. */
  @media (max-width: 480px) {
    .hdr__phone-label { display: none; }
    .hdr__phone strong { font-size: 1rem; }
    .hdr__cta { gap: 10px; }
  }
</style>

<script>
  const b = document.getElementById("burger");
  const n = document.getElementById("nav");

  const setOpen = (open: boolean) => {
    n?.classList.toggle("open", open);
    b?.setAttribute("aria-expanded", String(open));
  };

  b?.addEventListener("click", () => setOpen(!n?.classList.contains("open")));
  // close after following a link, and on Escape
  n?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && n?.classList.contains("open")) { setOpen(false); b?.focus(); }
  });
</script>
