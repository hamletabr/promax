---
import CallButton from "./CallButton.astro";
import EstimateButton from "./EstimateButton.astro";
const {
  eyebrow = "Local HVAC Experts",
  title,
  sub,
  image = "/images/high-photo-min.jpg",
  parentLabel,
  parentHref = "/",
  current,
} = Astro.props;
---
<section class="phero" style={`background-image:url('${image}')`}>
  <div class="phero__overlay"></div>
  <div class="container phero__inner">
    {parentLabel && (
      <nav class="phero__crumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span> <a href={parentHref}>{parentLabel}</a>
        {current && <> <span aria-hidden="true">/</span> <span aria-current="page">{current}</span></>}
      </nav>
    )}
    <span class="eyebrow eyebrow--light">{eyebrow}</span>
    <h1>{title}</h1>
    {sub && <p>{sub}</p>}
    <div class="phero__btns">
      <CallButton />
      <EstimateButton />
    </div>
  </div>
</section>

<style>
  .phero { position: relative; background-size: cover; background-position: center; color: #fff; }
  .phero__overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10,10,12,.93), rgba(10,10,12,.55)); }
  .phero__inner { position: relative; padding: 84px 22px; max-width: 740px; }
  .phero h1 { color: #fff; }
  .phero p { color: #d4d4d8; font-size: 1.1rem; max-width: 600px; }
  .phero__crumb { font-size: .85rem; color: #a1a1aa; margin-bottom: 16px; }
  .phero__crumb a { color: var(--amber); }
  .phero__crumb span { opacity: .5; }
  .eyebrow--light { color: #fff; }
  .phero__btns { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 26px; }
</style>
