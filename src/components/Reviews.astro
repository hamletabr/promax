---
import fs from "node:fs";
import path from "node:path";
import { reviews } from "../data/reviews";
import { site } from "../data/site";

// Initials for the fallback avatar, ignoring credential suffixes (EdD, LMFT, etc.)
function initials(name: string) {
  const parts = name.replace(/,.*$/, "").trim().split(/\s+/);
  return ((parts[0]?.[0] ?? "") + (parts[1]?.[0] ?? "")).toUpperCase();
}

// Auto-detect a profile photo in /public/images/reviews/ named after the review id.
let avatarFiles: string[] = [];
try {
  avatarFiles = fs.readdirSync(path.join(process.cwd(), "public", "images", "reviews"));
} catch {}
function avatarFor(id: string, fallback?: string) {
  const match = avatarFiles.find((f) => f.replace(/\.[^.]+$/, "") === id);
  return match ? `/images/reviews/${match}` : fallback ?? null;
}

const avatarColors = ["#ed6b00", "#41505d", "#0a9d6e", "#3b6fd4", "#b4476f", "#7a55c9"];

// Approx age in days from a relative ("7 months ago") or absolute ("May 2025") date string.
function ageDays(s = ""): number {
  if (!s) return 1e9;
  const str = String(s).toLowerCase().trim();
  if (/\d{4}/.test(str)) {                       // absolute date with a year
    const t = Date.parse(s);
    if (!isNaN(t)) return Math.max(0, (Date.now() - t) / 86400000);
  }
  if (/(just now|today|moment|hour|minute|second)/.test(str)) return 0;
  if (/yesterday/.test(str)) return 1;
  const m = str.match(/(\d+|a|an)\s*(day|week|month|year)/);
  if (m) {
    const num = m[1] === "a" || m[1] === "an" ? 1 : parseInt(m[1], 10);
    const mult: Record<string, number> = { day: 1, week: 7, month: 30, year: 365 };
    return num * mult[m[2]];
  }
  return 1e9;
}

// Sort newest -> oldest, then split into 3 time buckets (0 recent, 1 mid, 2 older).
const ranked = reviews
  .map((r) => ({ r, age: ageDays(r.date) }))
  .sort((a, b) => a.age - b.age);
const n = ranked.length;
const items = ranked.map((x, i) => {
  let bucket: number;
  if (n < 3) bucket = i;
  else if (i < Math.ceil(n / 3)) bucket = 0;
  else if (i < Math.ceil((n * 2) / 3)) bucket = 1;
  else bucket = 2;
  return { ...x.r, bucket };
});

const googleReviewsUrl = "https://www.google.com/maps/place/Promax+Service+Group/@37.3434987,-121.9851876,17z/data=!4m8!3m7!1s0x884da2ca13c669cd:0x6e0fcecb77b63e4a!8m2!3d37.3434945!4d-121.9826127!9m1!1b1!16s%2Fg%2F11lp6c3722?entry=ttu&g_ep=EgoyMDI2MDYwMy4xIKXMDSoASAFQAw%3D%3D";
---
<section class="section section--alt" id="reviews">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Reviews</span>
      <h2>What Our Customers Say</h2>
      <p>Real, verified reviews from homeowners across San Jose and the Bay Area.</p>
    </div>

    <div class="rev-grid" data-rev-rotator>
      {items.map((r, i) => {
        const avatar = avatarFor(r.id, r.avatar);
        return (
          <article class="rev" data-bucket={r.bucket}>
            <div class="rev__head">
              {avatar ? (
                <img class="rev__avatar-img" src={avatar} alt={r.name} loading="lazy" width="46" height="46" />
              ) : (
                <span class="rev__avatar" style={`background:${avatarColors[i % avatarColors.length]}`}>
                  {initials(r.name)}
                </span>
              )}
              <div class="rev__who">
                <strong>{r.name}</strong>
                <span class="rev__verified">
                  {r.source === "Google" || !r.source ? (
                    <svg class="rev__g" viewBox="0 0 48 48" aria-hidden="true">
                      <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
                      <path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/>
                      <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
                      <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303c-.792 2.237-2.231 4.166-4.087 5.571l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
                    </svg>
                  ) : (
                    <span class="rev__check">✓</span>
                  )}
                  Verified · {r.source ?? "Google"}
                </span>
              </div>
            </div>

            <div class="rev__stars-row">
              <div class="rev__stars" aria-label={`${r.rating} out of 5 stars`}>
                {Array.from({ length: 5 }).map((_, s) => (
                  <span class={s < r.rating ? "on" : ""}>★</span>
                ))}
              </div>
              {r.date && <span class="rev__date">{r.date}</span>}
            </div>

            <p class="rev__text">{r.text}{r.truncated ? "…" : ""}</p>

            {r.service && <span class="rev__tag">{r.service}</span>}
          </article>
        );
      })}
    </div>

    <div class="rev-more reveal">
      <a href={googleReviewsUrl} target="_blank" rel="noopener" class="btn btn--outline">Read more reviews on Google</a>
    </div>

    <div class="trust reveal">
      {site.trustBadges.map((b) =>
        b.url ? (
          <a href={b.url} class="trust__link" target="_blank" rel="noopener" aria-label={`${b.alt} — view profile`}>
            <img src={b.src} alt={b.alt} loading="lazy" />
          </a>
        ) : (
          <img src={b.src} alt={b.alt} loading="lazy" />
        )
      )}
    </div>
  </div>
</section>

<!-- Pick 3 reviews on each load: one from each time bucket (recent / mid / older).
     Runs inline before paint so non-chosen cards never flash. No-JS shows all. -->
<script is:inline>
  (function () {
    var grid = document.querySelector("[data-rev-rotator]");
    if (!grid) return;
    var cards = Array.prototype.slice.call(grid.querySelectorAll(".rev"));
    if (cards.length <= 3) return;

    var byBucket = {};
    cards.forEach(function (c) {
      var b = c.getAttribute("data-bucket") || "0";
      (byBucket[b] = byBucket[b] || []).push(c);
    });

    var chosen = [];
    Object.keys(byBucket).sort().forEach(function (k) {
      var arr = byBucket[k];
      chosen.push(arr[Math.floor(Math.random() * arr.length)]);
    });

    // Always land on exactly 3 cards.
    if (chosen.length > 3) chosen = chosen.slice(0, 3);
    if (chosen.length < 3) {
      var pool = cards.filter(function (c) { return chosen.indexOf(c) === -1; });
      while (chosen.length < 3 && pool.length) {
        chosen.push(pool.splice(Math.floor(Math.random() * pool.length), 1)[0]);
      }
    }

    cards.forEach(function (c) {
      if (chosen.indexOf(c) === -1) c.style.display = "none";
    });
  })();
</script>

<style>
  .rev-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .rev {
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius);
    padding: 26px; display: flex; flex-direction: column; gap: 14px; transition: .25s ease;
  }
  .rev:hover { box-shadow: var(--shadow-lg); transform: translateY(-5px); border-color: transparent; }

  .rev__head { display: flex; align-items: center; gap: 12px; }
  .rev__avatar, .rev__avatar-img {
    flex-shrink: 0; width: 46px; height: 46px; border-radius: 50%; object-fit: cover;
  }
  .rev__avatar {
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-family: var(--font-head); font-weight: 700; font-size: 1rem;
  }
  .rev__who { display: flex; flex-direction: column; line-height: 1.3; }
  .rev__who strong { color: var(--slate); font-size: .98rem; }
  .rev__verified { display: inline-flex; align-items: center; gap: 5px; color: var(--muted); font-size: .8rem; }
  .rev__g { width: 14px; height: 14px; }
  .rev__check { color: #0a9d6e; font-weight: 700; }

  .rev__stars-row { display: flex; align-items: center; justify-content: space-between; }
  .rev__stars { color: #d7dbe0; font-size: 1.05rem; letter-spacing: 2px; }
  .rev__stars .on { color: var(--amber); }
  .rev__date { color: var(--muted); font-size: .8rem; }

  .rev__text { color: var(--slate-2); font-size: .95rem; margin: 0; flex-grow: 1; }
  .rev__tag {
    align-self: flex-start; background: var(--orange-soft); color: var(--orange);
    font-size: .76rem; font-weight: 600; padding: 5px 12px; border-radius: 999px;
  }

  .rev-more { text-align: center; margin-top: 34px; }
  .trust {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: 30px; margin-top: 48px; padding-top: 40px; border-top: 1px solid var(--line);
  }
  .trust img { height: 62px; width: auto; object-fit: contain; filter: grayscale(.15); transition: .2s; display: block; }
  .trust img:hover { filter: none; transform: scale(1.05); }
  .trust__link { display: inline-flex; line-height: 0; border-radius: 8px; }
  .trust__link:hover img { filter: none; transform: scale(1.05); }
  .trust__link:focus-visible { outline: 2px solid var(--orange); outline-offset: 4px; }

  @media (max-width: 900px) { .rev-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .rev-grid { grid-template-columns: 1fr; } }
</style>
